SERVER = {'lan': False, 'tls': False, 'allowed_hosts': {'localhost', '127.0.0.1', '::1'}}
BUILD_SLOTS = threading.BoundedSemaphore(3)          # concurrent surface builds across all users


def is_loopback(ip):
    try:
        a = ipaddress.ip_address(ip)
        return a.is_loopback or (a.version == 6 and a.ipv4_mapped is not None and a.ipv4_mapped.is_loopback)
    except ValueError:
        return False


def viewer_may_pull():
    """Viewers may run live data functions only when that can't touch Bloomberg (or you allowed it)."""
    return VIEWERS_CAN_PULL or not BB.available()


_RESULTS, _BUILDS, _RESULT_LOCK = __import__('collections').OrderedDict(), __import__('collections').OrderedDict(), threading.Lock()


def serve_data(role, name, fn, *args, prefer_store=False):
    """Run a data function in the caller's data mode. Viewers: shared store only (no Bloomberg).
    You: live, or store-first for your page's automatic reloads."""
    if role == 'host':
        mode = 'prefer_store' if prefer_store else 'live'
    else:
        mode = 'live' if viewer_may_pull() else 'store'
    if name == 'surface':
        STORE.note_combo(args[0], None)
    elif len(args) >= 2:
        STORE.note_combo(args[0], args[1])
    key = (name, args, STORE.version)
    if mode != 'live':                       # results from the shared data are the same for everyone until it changes
        with _RESULT_LOCK:
            if key in _RESULTS:
                _RESULTS.move_to_end(key)
                return 200, _RESULTS[key]
    try:
        with data_mode_ctx(mode):
            out = fn(*args)
        if mode != 'live' and STORE.version == key[2]:
            with _RESULT_LOCK:
                _RESULTS[key] = out
                while len(_RESULTS) > 400:
                    _RESULTS.popitem(last=False)
        return 200, out
    except NotInStore as e:
        STORE.want_combo(args[0], None if name == 'surface' else args[1])
        what = args[0] if name == 'surface' else f'{args[0]}/{args[1]} {name.replace("_", " ")}' + (f' {args[2]}' if len(args) > 2 and isinstance(args[2], str) else '')
        return 409, {'queued': True, 'error': f'{what} isn\'t in the shared data yet. Queued: it will be pulled at the next refresh '
                                              f'({REFRESH["next"] or "when the host refreshes"}), or the host can press Refresh now. '
                                              f'[{e.short()}]'}


def host_of(header):
    """Hostname part of a Host header: 'Box:8090' -> 'box', '[::1]:8090' -> '::1'."""
    h = (header or '').strip().lower()
    if h.startswith('['):
        return h[1:h.find(']')] if ']' in h else h
    return h.rsplit(':', 1)[0] if h.count(':') == 1 else h


def local_addresses():
    """Names and IPs this machine answers to (for the Host check and the printed URLs)."""
    names = {'localhost', '127.0.0.1', '::1'}
    hn = socket.gethostname()
    names |= {hn.lower(), socket.getfqdn().lower()}
    try:
        names |= set(socket.gethostbyname_ex(hn)[2])
    except OSError:
        pass
    try:                                             # primary LAN address (no packet is sent)
        s_ = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s_.connect(('10.255.255.255', 1))
        names.add(s_.getsockname()[0])
        s_.close()
    except OSError:
        pass
    return {n for n in names if n}


def _is_ip(x):
    try:
        ipaddress.ip_address(x)
        return True
    except ValueError:
        return False


def make_self_signed(cert_path, key_path, names, days=825):
    """Self-signed certificate covering every name/IP in `names`. Uses the `cryptography` package,
    else the openssl command line."""
    dns = sorted(n for n in names if not _is_ip(n))
    ips = sorted(n for n in names if _is_ip(n))
    try:
        from cryptography import x509
        from cryptography.hazmat.primitives import hashes, serialization
        from cryptography.hazmat.primitives.asymmetric import ec
        from cryptography.x509.oid import NameOID
        key = ec.generate_private_key(ec.SECP256R1())
        subj = x509.Name([x509.NameAttribute(NameOID.COMMON_NAME, (dns or ['crossvol'])[0][:64]),
                          x509.NameAttribute(NameOID.ORGANIZATION_NAME, 'Cross Vol Builder (self-signed)')])
        now = datetime.now(timezone.utc)
        san = [x509.DNSName(d) for d in dns] + [x509.IPAddress(ipaddress.ip_address(i)) for i in ips]
        cert = (x509.CertificateBuilder().subject_name(subj).issuer_name(subj).public_key(key.public_key())
                .serial_number(x509.random_serial_number()).not_valid_before(now - timedelta(minutes=5))
                .not_valid_after(now + timedelta(days=days))
                .add_extension(x509.SubjectAlternativeName(san), critical=False)
                .add_extension(x509.BasicConstraints(ca=False, path_length=None), critical=True)
                .sign(key, hashes.SHA256()))
        with open(key_path, 'wb') as fh:
            fh.write(key.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption()))
        with open(cert_path, 'wb') as fh:
            fh.write(cert.public_bytes(serialization.Encoding.PEM))
    except ImportError:
        san = ','.join([f'DNS:{d}' for d in dns] + [f'IP:{i}' for i in ips])
        try:
            subprocess.run(['openssl', 'req', '-x509', '-newkey', 'ec', '-pkeyopt', 'ec_paramgen_curve:prime256v1', '-nodes',
                            '-keyout', key_path, '-out', cert_path, '-days', str(days), '-subj', f'/CN={(dns or ["crossvol"])[0][:64]}',
                            '-addext', f'subjectAltName={san}'], check=True, capture_output=True)
        except (OSError, subprocess.CalledProcessError) as e:
            raise SystemExit('Could not create a TLS certificate: install it with  pip install cryptography  '
                             f'or pass --cert / --key (your firm\'s certificate is better anyway). ({e})')
    try:
        os.chmod(key_path, 0o600)
    except OSError:
        pass


def cert_names(cert_path):
    """Names in a PEM certificate's SAN (best effort; empty set if unreadable)."""
    try:
        from cryptography import x509
        c = x509.load_pem_x509_certificate(open(cert_path, 'rb').read())
        san = c.extensions.get_extension_for_class(x509.SubjectAlternativeName).value
        return {str(v).lower() for v in san.get_values_for_type(x509.DNSName)} | {str(v) for v in san.get_values_for_type(x509.IPAddress)}
    except Exception:
        return set()


def cert_fingerprint(cert_path):
    der = ssl.PEM_cert_to_DER_cert(open(cert_path).read())
    d = hashlib.sha256(der).hexdigest().upper()
    return ':'.join(d[i:i + 2] for i in range(0, len(d), 2))


def tls_context(cert, key, names):
    """Your --cert/--key, else a self-signed pair in ./crossvol_tls (regenerated if this machine's
    names changed)."""
    if not (cert and key):
        d = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'crossvol_tls')
        os.makedirs(d, exist_ok=True)
        cert, key = os.path.join(d, 'cert.pem'), os.path.join(d, 'key.pem')
        if not (os.path.exists(cert) and os.path.exists(key)) or not (names <= cert_names(cert)):
            log('creating a self-signed TLS certificate in ' + d)
            make_self_signed(cert, key, names)
    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    ctx.minimum_version = ssl.TLSVersion.TLSv1_2
    ctx.load_cert_chain(cert, key)
    return ctx, cert


class Server(ThreadingHTTPServer):
    daemon_threads = True

    def handle_error(self, request, client_address):
        import sys as _sys
        e = _sys.exc_info()[1]
        if isinstance(e, (ssl.SSLError, ConnectionError, TimeoutError, socket.timeout)):
            return                                   # plain-HTTP probe on the HTTPS port, dropped client, idle timeout
        log(f'request from {client_address[0]} failed: {type(e).__name__}: {e}')


