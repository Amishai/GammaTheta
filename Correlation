function pctTxt(p){return p==null?'—':Math.round(p)+(Math.round(p)%10===1&&Math.round(p)!==11?'st':Math.round(p)%10===2&&Math.round(p)!==12?'nd':Math.round(p)%10===3&&Math.round(p)!==13?'rd':'th')+' pct';}
function cls(x){return x==null?'':(x>0?'pos':'negv');}
function renderAnBody(){
  const H=S.hist,st=H.stats,el=$('anBody');
  if(st.error){el.innerHTML='<div class="empty err">'+st.error+'</div>';return;}
  const n=st.now,p=st.premium||{},bl=st.backtest_long||{},bv=bl.vol||{},c=st.conditional,cx=H.cross;
  const row=(k,v,cl)=>'<tr><td>'+k+'</td><td class="'+(cl||'')+'">'+v+'</td></tr>';
  let t='<table class="kv">';
  t+='<tr class="h"><td colspan="2">Now ('+st.asof+', '+st.tenor+')</td></tr>';
  t+=row('Implied ρ',f(n.implied,3)+' · '+pctTxt(n.implied_pct)+' of lookback'+(n.implied_z!=null?' · z '+sgn(n.implied_z,2):''));
  t+=row('Trailing realized ('+(H.window_trail||st.window)+'d, zero-mean)',f(n.trailing,3));
  t+=row('Implied − trailing',sgn(n.spread,3)+' · '+pctTxt(n.spread_pct));
  t+=row('Cross vol per 0.01 ρ',f(n.dvol_drho/100,3)+' vol (σA·σB / σX)');
  t+='<tr class="h"><td colspan="2">Premium: implied − subsequently realized (over the option\'s life)</td></tr>';
  t+=row('Mean / median',sgn(p.mean,3)+' / '+sgn(p.median,3)+(p.t!=null?' · t '+f(p.t,1)+' (overlapping days, overstated)':''));
  t+=row('Implied ended above realized',f(p.hit,0)+'% of '+(p.n||0)+' days');
  t+=row('10th – 90th pct',sgn(p.p10,3)+' to '+sgn(p.p90,3));
  t+='<tr class="h"><td colspan="2">Backtest: enter every '+st.window+'d, hold to expiry ('+st.backtest_entries+' non-overlapping trades)</td></tr>';
  t+=row('Long ρ: avg P&L (ρ pts)',sgn(bl.mean,3)+' · hit '+f(bl.hit,0)+'%',cls(bl.mean));
  t+=row('Long ρ: avg P&L (cross vol pts)',sgn(bv.mean,3)+' · worst '+sgn(bv.min,3)+' · best '+sgn(bv.max,3),cls(bv.mean));
  t+=row('Short ρ: avg P&L (cross vol pts)',sgn(bv.mean==null?null:-bv.mean,3)+' · hit '+f(bl.hit==null?null:100-bl.hit,0)+'%',cls(bv.mean==null?null:-bv.mean));
  t+=row('Avg / std (per trade)',bv.std?f(bv.mean/bv.std,2):'—');
  if(c){t+='<tr class="h"><td colspan="2">Conditional on today\'s spread ('+(n.spread>=0?'implied − trailing ≥ ':'≤ ')+sgn(n.spread,3)+')</td></tr>';
    t+=row('Days like today',c.n+' (≈'+c.eff_n+' independent)');
    t+=row('Realized ended below implied (short ρ won)',f(c.short_hit,0)+'%');
    t+=row('Avg implied − realized on those days',sgn(c.mean_prem,3));}
  t+='</table>';
  // evidence, stated as numbers rather than a recommendation
  const ev=[];
  if(n.spread<0)ev.push('Implied ρ is <b>'+f(-n.spread,3)+' below</b> trailing realized ('+pctTxt(n.spread_pct)+'): if realized stays where it has been, <b>long correlation</b> (short '+cx+' vol vs legs) earns ≈ '+f(-n.spread*n.dvol_drho,2)+' cross vol pts.');
  else ev.push('Implied ρ is <b>'+f(n.spread,3)+' above</b> trailing realized ('+pctTxt(n.spread_pct)+'): if realized stays where it has been, <b>short correlation</b> (long '+cx+' vol vs legs) earns ≈ '+f(n.spread*n.dvol_drho,2)+' cross vol pts.');
  if(p.n)ev.push('Over the lookback, implied ended '+(p.mean<0?'<b>below</b>':'<b>above</b>')+' subsequent realized on average by '+f(Math.abs(p.mean),3)+' ('+f(p.mean<0?100-p.hit:p.hit,0)+'% of days): historically that favoured <b>'+(p.mean<0?'long':'short')+' correlation</b>.');
