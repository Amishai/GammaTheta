# ======================================================================
# Pair / convention helpers
# ======================================================================
def split_pair(pair):
    p = pair.upper().replace('/', '').strip()
    if len(p) != 6:
        raise ValueError(f'Bad pair {pair!r}')
    return p[:3], p[3:]


def leg_info(pair):
    """Return (non-USD currency, orientation). +1 for cUSD, -1 for USDc."""
    b, q = split_pair(pair)
    if q == 'USD' and b != 'USD':
        return b, +1
    if b == 'USD' and q != 'USD':
        return q, -1
    raise ValueError(f'{pair} is not a USD pair')


def _rank(c):
    return CCY_RANK.index(c) if c in CCY_RANK else len(CCY_RANK) - 1.5


def cross_ccys(pair_a, pair_b):
    """(base, quote) of the cross implied by two USD legs."""
    ca, _ = leg_info(pair_a)
    cb, _ = leg_info(pair_b)
    if ca == cb:
        raise ValueError('Both legs are the same currency')
    return (ca, cb) if _rank(ca) < _rank(cb) else (cb, ca)


def default_premium_adjusted(pair):
    """Premium-adjusted delta unless USD is the quote ccy (EURUSD, GBPUSD...).
    USDxxx (premium in USD = base) and crosses (premium in base) are PA."""
    _, q = split_pair(pair)
    return q != 'USD'


def default_delta_type(pair, T):
    b, q = split_pair(pair)
    if b in EM_CCYS or q in EM_CCYS:
        return 'forward'
    return 'spot' if T <= 1.0 + 1e-9 else 'forward'


def pip_scale_from_spot(spot):
    """Fallback fwd-point scale (same heuristic as the dashboard)."""
    if spot > 500:
        return 1.0
    if spot > 50:
        return 100.0
    return 10000.0


def _add_months(d, m):
    y = d.year + (d.month - 1 + m) // 12
    mo = (d.month - 1 + m) % 12 + 1
    return date(y, mo, min(d.day, calendar.monthrange(y, mo)[1]))


def tenor_to_T(tenor, today=None):
    """ACT/365 year fraction to a simple calendar expiry (no spot lag / holidays)."""
    today = today or date.today()
    n, u = int(tenor[:-1]), tenor[-1].upper()
    if u == 'W':
        exp = today + timedelta(days=7 * n)
    elif u == 'M':
        exp = _add_months(today, n)
    elif u == 'Y':
        exp = _add_months(today, 12 * n)
    else:
        raise ValueError(tenor)
    return max((exp - today).days, 1) / 365.0


# ======================================================================
# Black-76 (undiscounted, forward terms)
# ======================================================================
def npdf(x):
    return np.exp(-0.5 * np.asarray(x) ** 2) / SQRT2PI


def _d12(F, K, T, sig):
    sd = sig * np.sqrt(T)
    d1 = (np.log(F / K) + 0.5 * sd * sd) / sd
    return d1, d1 - sd, sd


def black(F, K, T, sig, cp):
    d1, d2, _ = _d12(F, K, T, sig)
    return cp * (F * ndtr(cp * d1) - K * ndtr(cp * d2))


def implied_vol(price, F, K, T, cp, lo=1e-4, hi=4.0):
    intrinsic = max(cp * (F - K), 0.0)
    if not np.isfinite(price) or price <= intrinsic + 1e-15 * F:
        return float('nan')
    f = lambda s: float(black(F, K, T, s, cp)) - price
    if f(lo) > 0 or f(hi) < 0:
        return float('nan')
    return brentq(f, lo, hi, xtol=1e-12, maxiter=200)


def bs_delta(F, K, T, sig, cp, pa, dfb):
    """Call/put delta. dfb = base-ccy discount factor for spot delta, 1.0 for forward."""
    d1, d2, _ = _d12(F, K, T, sig)
    if pa:
        return cp * dfb * (K / F) * ndtr(cp * d2)
    return cp * dfb * ndtr(cp * d1)


def strike_from_delta(F, T, sig, target, cp, pa, dfb):
    """Strike with |delta| = target at a FIXED vol sig (pillar / strangle strikes)."""
    sd = sig * math.sqrt(T)
    if not pa:
        a = target / dfb
        if not 0 < a < 1:
            raise ValueError('delta target unreachable')
        d1 = cp * float(ndtri(a))
        return F * math.exp(-d1 * sd + 0.5 * sd * sd)

    def f(k):
        return abs(float(bs_delta(F, F * math.exp(k), T, sig, cp, True, dfb))) - target

    span = 20 * sd + 1.0
    if cp < 0:                          # PA put: |delta| increasing in K on OTM side
        return F * math.exp(brentq(f, -span, 0.0, xtol=1e-13))
    # PA call: |delta| = dfb*(K/F)*N(d2) rises then falls; OTM root is right of the peak
    def g(k):
        d2 = (-k - 0.5 * sd * sd) / sd
        return float(ndtr(d2)) - float(npdf(d2)) / sd
    # g>0 deep left (N(d2)->1); g<0 by d2=-3 (k = 3sd - sd^2/2) for any sd < 3.
    # Don't bracket further right: N and phi both underflow to 0 there.
    kp = brentq(g, -span, 3 * sd - 0.5 * sd * sd, xtol=1e-13)
    if f(kp) < 0:
        raise ValueError('PA call delta target above the delta peak')
    return F * math.exp(brentq(f, kp, kp + span, xtol=1e-13))


def dns_strike(F, T, sig, pa):
    return F * math.exp((-0.5 if pa else 0.5) * sig * sig * T)


# ======================================================================
# Smile: natural cubic spline in k = ln(K/F) + C2 tanh tails
# ======================================================================
class Smile:
    def __init__(self, F, T, ks, vols, tail_scale=1.0):
        ks = np.asarray(ks, float)
        vols = np.asarray(vols, float)
        o = np.argsort(ks)
        ks, vols = ks[o], vols[o]
        if np.any(np.diff(ks) <= 0):
            raise ValueError('smile strikes not strictly increasing')
        self.F, self.T = F, T
        self.ks, self.vols = ks, vols
        self.cs = CubicSpline(ks, vols, bc_type='natural')
        self.klo, self.khi = ks[0], ks[-1]
        self.vlo, self.vhi = vols[0], vols[-1]
        self.slo, self.shi = float(self.cs(self.klo, 1)), float(self.cs(self.khi, 1))
        atm = float(self.cs(np.clip(0.0, self.klo, self.khi)))
        self.L = max(tail_scale * atm * math.sqrt(T), 1e-4)
        self.floor = 0.25 * float(vols.min())

    def vol_k(self, k):
        k = np.asarray(k, float)
        out = np.empty_like(k)
        lo, hi = k < self.klo, k > self.khi
        mid = ~(lo | hi)
        out[mid] = self.cs(k[mid])
        out[hi] = self.vhi + self.shi * self.L * np.tanh((k[hi] - self.khi) / self.L)
        out[lo] = self.vlo + self.slo * self.L * np.tanh((k[lo] - self.klo) / self.L)
        return np.maximum(out, self.floor)

    def dvol_dk(self, k):
        k = np.asarray(k, float)
        out = np.empty_like(k)
        lo, hi = k < self.klo, k > self.khi
        mid = ~(lo | hi)
        out[mid] = self.cs(k[mid], 1)
        out[hi] = self.shi / np.cosh((k[hi] - self.khi) / self.L) ** 2
        out[lo] = self.slo / np.cosh((k[lo] - self.klo) / self.L) ** 2
        raw = np.where(lo, self.vlo + self.slo * self.L * np.tanh((k - self.klo) / self.L),
                       np.where(hi, self.vhi + self.shi * self.L * np.tanh((k - self.khi) / self.L), 1.0))
        out[raw < self.floor] = 0.0
        return out

    def vol(self, K):
        return self.vol_k(np.log(np.asarray(K, float) / self.F))

    def dvol_dK(self, K):
        K = np.asarray(K, float)
        return self.dvol_dk(np.log(K / self.F)) / K


# ======================================================================
# Leg construction from ATM / RR / BF quotes
# ======================================================================
def pillar_smile(F, T, atm, rr25, rr10, bs25, bs10, pa, dfb):
    vols = {'10P': atm + bs10 - rr10 / 2, '25P': atm + bs25 - rr25 / 2, 'ATM': atm,
            '25C': atm + bs25 + rr25 / 2, '10C': atm + bs10 + rr10 / 2}
    if min(vols.values()) <= 0:
        raise ValueError('non-positive pillar vol')
    K = {'10P': strike_from_delta(F, T, vols['10P'], 0.10, -1, pa, dfb),
         '25P': strike_from_delta(F, T, vols['25P'], 0.25, -1, pa, dfb),
         'ATM': dns_strike(F, T, atm, pa),
         '25C': strike_from_delta(F, T, vols['25C'], 0.25, +1, pa, dfb),
         '10C': strike_from_delta(F, T, vols['10C'], 0.10, +1, pa, dfb)}
    order = ['10P', '25P', 'ATM', '25C', '10C']
    ks = [math.log(K[p] / F) for p in order]
    if any(b <= a for a, b in zip(ks, ks[1:])):
        raise ValueError('pillar strikes not monotone (check RR/BF inputs)')
    return Smile(F, T, ks, [vols[p] for p in order]), {p: (K[p], vols[p]) for p in order}


def strangle_mismatch(smile, F, T, atm, bf_mkt, d, pa, dfb):
    """Smile-priced market strangle minus flat-vol market strangle (forward units)."""
    sm = atm + bf_mkt
    Kc = strike_from_delta(F, T, sm, d, +1, pa, dfb)
    Kp = strike_from_delta(F, T, sm, d, -1, pa, dfb)
    target = black(F, Kc, T, sm, 1) + black(F, Kp, T, sm, -1)
    on_smile = black(F, Kc, T, float(smile.vol(Kc)), 1) + black(F, Kp, T, float(smile.vol(Kp)), -1)
    return float(on_smile - target)


def _root_near(f, guess, step=0.002, max_step=0.06):
    """Bracket a root around guess by expanding steps, then brentq."""
    h = step
    while h <= max_step + 1e-12:
        a, b = guess - h, guess + h
        try:
            fa, fb = f(a), f(b)
            if np.isfinite(fa) and np.isfinite(fb) and fa * fb <= 0:
                return brentq(f, a, b, xtol=1e-12)
        except ValueError:
            pass
        h *= 2
    raise ValueError('could not bracket fly solve')


def build_leg(pair, S, F, T, q, df_usd, fly_conv='broker', pa=None, dtype=None):
    """q: dict with atm, rr25, rr10, bf25, bf10 (decimals)."""
    ccy, orient = leg_info(pair)
    pa = default_premium_adjusted(pair) if pa is None else pa
    dtype = dtype or default_delta_type(pair, T)
    df_base = df_usd * F / S if orient > 0 else df_usd          # base-ccy df via CIP
    df_ccy = df_usd * F / S if orient > 0 else df_usd * S / F   # non-USD ccy df
    dfb = df_base if dtype == 'spot' else 1.0
    atm, rr25, rr10, bf25, bf10 = (q[k] for k in ('atm', 'rr25', 'rr10', 'bf25', 'bf10'))

    if fly_conv == 'smile':
        bs25, bs10 = bf25, bf10
    else:
        bs25, bs10 = bf25, bf10
        for _ in range(40):
            def e25(x):
                s, _ = pillar_smile(F, T, atm, rr25, rr10, x, bs10, pa, dfb)
                return strangle_mismatch(s, F, T, atm, bf25, 0.25, pa, dfb)
            n25 = _root_near(e25, bs25)

            def e10(x):
                s, _ = pillar_smile(F, T, atm, rr25, rr10, n25, x, pa, dfb)
                return strangle_mismatch(s, F, T, atm, bf10, 0.10, pa, dfb)
            n10 = _root_near(e10, bs10)
            done = abs(n25 - bs25) < 1e-9 and abs(n10 - bs10) < 1e-9
            bs25, bs10 = n25, n10
            if done:
                break
    smile, pillars = pillar_smile(F, T, atm, rr25, rr10, bs25, bs10, pa, dfb)
    return {'pair': pair, 'ccy': ccy, 'orient': orient, 'S': S, 'F': F, 'T': T,
            'pa': pa, 'dtype': dtype, 'dfb': dfb, 'df_ccy': df_ccy, 'atm': atm,
            'smile': smile, 'pillars': pillars, 'bs25': bs25, 'bs10': bs10,
            'bf25_in': bf25, 'bf10_in': bf10, 'fly_conv': fly_conv}


# ======================================================================
# Marginal of Y (USD per unit ccy) under the USD T-forward measure
# ======================================================================
class Marginal:
    def __init__(self, leg, nz=2401, zmax=9.0, nk=6001):
        sm, F, T, orient = leg['smile'], leg['F'], leg['T'], leg['orient']
        rt = math.sqrt(T)
        probe = sm.vol_k(np.linspace(-10, 10, 41) * leg['atm'] * rt)
        span = 12.0 * float(probe.max()) * rt + 0.02
        k = np.linspace(-span, span, nk)
        K = F * np.exp(k)
        sig = sm.vol_k(k)
        ds = sm.dvol_dk(k) / K
        sd = sig * rt
        d1 = (-k + 0.5 * sd * sd) / sd
        d2 = d1 - sd
        if orient > 0:   # Y = X, X under its own (USD) measure
            skew = F * npdf(d1) * rt * ds
            cdf_x, sf_x = ndtr(-d2) + skew, ndtr(d2) - skew
            y, cdf, sf = K, cdf_x, sf_x
        else:            # Y = 1/X; X re-weighted to the USD measure
            skew = K * npdf(d1) * rt * ds
            G, Gs = ndtr(-d1) + skew, ndtr(d1) - skew
            y, cdf, sf = (1.0 / K)[::-1], Gs[::-1], G[::-1]

        # butterfly-arbitrage diagnostic: CDF must be non-decreasing
        raw_drops = np.diff(cdf) < -1e-9
        self.arb_points = int(raw_drops.sum())
        tiny = 1e-300
        cdf = np.maximum.accumulate(np.clip(cdf, tiny, 1.0))
        sf = np.minimum.accumulate(np.clip(sf, tiny, 1.0))
        lny = np.log(y)

        z = np.linspace(-zmax, zmax, nz)
        lnY = np.empty_like(z)
        neg = z <= 0
        lc, idx = np.unique(np.log(cdf), return_index=True)
        lnY[neg] = np.interp(log_ndtr(z[neg]), lc, lny[idx])
        ls, idx2 = np.unique(np.log(sf), return_index=True)        # ascending log sf
        lnY[~neg] = np.interp(log_ndtr(-z[~neg]), ls, lny[idx2])
        lnY = np.maximum.accumulate(lnY)
        lnY += np.arange(nz) * 1e-14                               # strictly increasing

        FY = F if orient > 0 else 1.0 / F
        w = npdf(z) * np.gradient(z)
        w[0] *= 0.5
        w[-1] *= 0.5
        mean = float(np.sum(w * np.exp(lnY)) / np.sum(w))
        self.mean_err = mean / FY - 1.0                           # pre-normalisation drift
        lnY += math.log(FY / mean)
        self.z, self.lnY, self.FY = z, lnY, FY

    def Q(self, z):
        return np.exp(np.interp(z, self.z, self.lnY))

    def Qinv(self, y):
        return np.interp(np.log(y), self.lnY, self.z)


# ======================================================================
# Gaussian-copula cross pricer:  Call(K) = E_usd[(Y_A - K*Y_B)^+] / F_YB
# ======================================================================
class CrossPricer:
    def __init__(self, MA, MB, rho_y, nz1=601, nw=1601, zmax=8.5):
        rho = float(np.clip(rho_y, -0.999, 0.999))
        self.MA, self.MB, self.rho = MA, MB, rho
        self.sr = math.sqrt(1 - rho * rho)
        z1 = np.linspace(-zmax, zmax, nz1)
        w1 = npdf(z1) * (z1[1] - z1[0])
        w1[0] *= 0.5
        w1[-1] *= 0.5
        self.z1, self.w1 = z1, w1 / w1.sum()
        w = np.linspace(-zmax, zmax, nw)
        self.w0, self.dw, self.nw = w[0], w[1] - w[0], nw
        self.YA = MA.Q(z1)
        if not (np.all(np.isfinite(MA.lnY)) and np.all(np.isfinite(MB.lnY)) and math.isfinite(rho)):
            raise ValueError('non-finite marginal or correlation reached the copula (check leg inputs / rho)')
        YB = MB.Q(rho * z1[:, None] + self.sr * w[None, :])
        f = YB * npdf(w)[None, :]
        g = np.broadcast_to(npdf(w), f.shape)
        cum = lambda a: np.concatenate([np.zeros((a.shape[0], 1)),
                                        np.cumsum(0.5 * (a[:, 1:] + a[:, :-1]) * self.dw, axis=1)], axis=1)
        self.cumB, self.cumP = cum(f), cum(g)
        self.totB, self.totP = self.cumB[:, -1], self.cumP[:, -1]
        self.FX = MA.FY / MB.FY
        # forward check: E[Y_A]/E[Y_B] from the 2-D quadrature
        self.fwd_err = float(np.sum(self.w1 * self.YA) / np.sum(self.w1 * self.totB) / self.FX - 1.0)

    def _interp_rows(self, cum, wstar):
        x = np.clip((wstar - self.w0) / self.dw, 0.0, self.nw - 1 - 1e-9)
        i = np.floor(x).astype(int)
        t = x - i
        r = np.arange(cum.shape[0])
        return cum[r, i] * (1 - t) + cum[r, i + 1] * t

    def call_put(self, K):
        zstar = self.MB.Qinv(self.YA / K)
        wstar = (zstar - self.rho * self.z1) / self.sr
        pB = self._interp_rows(self.cumB, wstar)
        pP = self._interp_rows(self.cumP, wstar)
        call = self.YA * pP - K * pB                       # Y_B < Y_A/K region
        put = K * (self.totB - pB) - self.YA * (self.totP - pP)
        FYB = self.MB.FY
        return float(np.sum(self.w1 * call) / FYB), float(np.sum(self.w1 * put) / FYB)

    def iv(self, K, T):
        c, p = self.call_put(K)
        F = self.FX
        return implied_vol(c, F, K, T, 1) if K >= F else implied_vol(p, F, K, T, -1)


# ======================================================================
# Extract cross pillars from a strike-space smile
# ======================================================================
def dns_self_consistent(smile, T, pa):
    k = 0.0
    s = -0.5 if pa else 0.5
    for _ in range(100):
        k_new = s * float(smile.vol_k(k)) ** 2 * T
        if abs(k_new - k) < 1e-14:
            break
        k = k_new
    return k, float(smile.vol_k(k))


def delta_strike_on_smile(smile, F, T, d, cp, pa, dfb, sd_ref):
    """Strike where delta(K, sigma(K)) = d, on the OTM branch."""
    def f(k):
        return abs(float(bs_delta(F, F * math.exp(k), T, float(smile.vol_k(k)), cp, pa, dfb))) - d
    grid = np.linspace(-10 * sd_ref, 10 * sd_ref, 801)
    vals = np.abs(bs_delta(F, F * np.exp(grid), T, smile.vol_k(grid), cp, pa, dfb)) - d
    if cp > 0:   # rightmost + -> - crossing
        idx = [i for i in range(len(grid) - 1) if vals[i] > 0 >= vals[i + 1]]
        if not idx:
            raise ValueError('call delta not found')
        i = idx[-1]
    else:        # leftmost - -> + crossing
        idx = [i for i in range(len(grid) - 1) if vals[i] < 0 <= vals[i + 1]]
        if not idx:
            raise ValueError('put delta not found')
        i = idx[0]
    k = brentq(f, grid[i], grid[i + 1], xtol=1e-13)
    return k, float(smile.vol_k(k))


def broker_fly_from_smile(smile, F, T, atm, d, pa, dfb):
    f = lambda b: strangle_mismatch(smile, F, T, atm, b, d, pa, dfb)
    guess = 0.5 * (float(smile.vol(strike_from_delta(F, T, atm, d, 1, pa, dfb))) +
                   float(smile.vol(strike_from_delta(F, T, atm, d, -1, pa, dfb)))) - atm
    return _root_near(f, guess)


def smile_pillars(smile, F, T, pa, dfb):
    sd = max(float(smile.vol_k(0.0)), 1e-3) * math.sqrt(T)
    k_atm, v_atm = dns_self_consistent(smile, T, pa)
    out = {'ATM': (F * math.exp(k_atm), v_atm)}
    for lab, d, cp in (('25C', 0.25, 1), ('25P', 0.25, -1), ('10C', 0.10, 1), ('10P', 0.10, -1)):
        k, v = delta_strike_on_smile(smile, F, T, d, cp, pa, dfb, sd)
        out[lab] = (F * math.exp(k), v)
    atm = v_atm
    res = {'atm': atm,
           'rr25': out['25C'][1] - out['25P'][1], 'rr10': out['10C'][1] - out['10P'][1],
           'bf25s': 0.5 * (out['25C'][1] + out['25P'][1]) - atm,
           'bf10s': 0.5 * (out['10C'][1] + out['10P'][1]) - atm,
           'pillars': out}
    try:
        res['bf25b'] = broker_fly_from_smile(smile, F, T, atm, 0.25, pa, dfb)
        res['bf10b'] = broker_fly_from_smile(smile, F, T, atm, 0.10, pa, dfb)
    except ValueError:
        res['bf25b'] = res['bf10b'] = float('nan')
    return res


# ======================================================================
# Variance-formula ATM + sensitivities
# ======================================================================
def variance_formula(sa, sb, rho_y):
    v = sa * sa + sb * sb - 2 * rho_y * sa * sb
    s = math.sqrt(max(v, 1e-12))
    return {'atm': s,
            'd_sa': (sa - rho_y * sb) / s,       # d sigma_x / d sigma_A
            'd_sb': (sb - rho_y * sa) / s,       # d sigma_x / d sigma_B
            'd_rho_y': -sa * sb / s}             # d sigma_x / d rho_Y


# ======================================================================
# SABR (beta = 1, Hagan lognormal) — same model as the dashboard's Vol of Vol tab
# ======================================================================
def sabr_vol(F, K, T, a, r, n):
    K = np.asarray(K, float)
    z = n / a * np.log(F / K)
    small = np.abs(z) < 1e-8
    zs = np.where(small, 1e-8, z)
    x = np.log((np.sqrt(1 - 2 * r * zs + zs * zs) + zs - r) / (1 - r))
    zx = np.where(small, 1.0 - 0.5 * r * z, zs / x)
    return a * zx * (1 + (r * n * a / 4 + (2 - 3 * r * r) * n * n / 24) * T)


def fit_sabr(F, T, Ks, vols):
    """Least-squares (alpha, rho, nu) through the 5 pillar strike/vol points."""
    Ks, vols = np.asarray(Ks, float), np.asarray(vols, float)
    best = None
    for r0 in (-0.3, 0.0, 0.3):
        res = least_squares(lambda p: sabr_vol(F, Ks, T, p[0], p[1], p[2]) - vols,
                            [float(np.median(vols)), r0, 0.8],
                            bounds=([1e-4, -0.999, 1e-4], [3.0, 0.999, 10.0]), xtol=1e-12, ftol=1e-14)
        if best is None or res.cost < best.cost:
            best = res
    a, r, n = best.x
    return {'alpha': float(a), 'rho': float(r), 'nu': float(n), 'err': float(np.max(np.abs(best.fun)))}


def propagate_vov(sa, sb, rho_y, nu_a, nu_b, rho_sig, sig_rho):
    """Cross vol-of-vol from leg vol-of-vols.
    sigma_X^2 = sa^2 + sb^2 - 2 rho sa sb  ->  d sigma_X = dA d sa + dB d sb + dR d rho
    (nu_X sigma_X)^2 = (dA nu_a sa)^2 + (dB nu_b sb)^2 + 2 rho_sig (dA nu_a sa)(dB nu_b sb) + (dR sig_rho)^2
    rho_sig = correlation of the two legs' vol moves; sig_rho = annualized vol of rho (absolute).
    The weights wA = dA sa / sX, wB = dB sb / sX sum to exactly 1, so with rho_sig = 1 and
    sig_rho = 0, nu_X is the weighted average of nu_a and nu_b."""
    vf = variance_formula(sa, sb, rho_y)
    sx = vf['atm']
    ea, eb = vf['d_sa'] * nu_a * sa, vf['d_sb'] * nu_b * sb
    ec = vf['d_rho_y'] * sig_rho
    var = ea * ea + eb * eb + 2 * rho_sig * ea * eb + ec * ec
    return {'nu_x': math.sqrt(max(var, 0.0)) / sx, 'w_a': vf['d_sa'] * sa / sx, 'w_b': vf['d_sb'] * sb / sx,
            # contributions to (nu_X sigma_X)^2, in (vol pts / yr)^2 — shows what drives the fly
            'var_parts': {'leg_a': ea * ea * 1e4, 'leg_b': eb * eb * 1e4,
                          'cross': 2 * rho_sig * ea * eb * 1e4, 'corr': ec * ec * 1e4}}


def ou_factor(T, half_life):
    """Correlation mean-reverts. For an OU rho with speed k = ln2/half_life, Var(rho_T) =
    sig^2 (1 - e^{-2kT}) / (2k), so the vol of rho to use over horizon T is
    sig * sqrt((1 - e^{-2kT}) / (2kT)). -> 1 for short tenors, ~1/sqrt(T) for long ones."""
    if not half_life or half_life <= 0:
        return 1.0
    x = 2 * math.log(2) / half_life * T
    return math.sqrt(-math.expm1(-x) / x) if x > 1e-10 else 1.0


def sabr_smile(F, T, a, r, n, atm):
    ks = np.linspace(-7, 7, 141) * atm * math.sqrt(T)
    return Smile(F, T, ks, sabr_vol(F, F * np.exp(ks), T, a, r, n))


def rr25_on(smile, F, T, pa, dfb):
    sd = max(float(smile.vol_k(0.0)), 1e-3) * math.sqrt(T)
    _, vc = delta_strike_on_smile(smile, F, T, 0.25, 1, pa, dfb, sd)
    _, vp = delta_strike_on_smile(smile, F, T, 0.25, -1, pa, dfb, sd)
    return vc - vp


def cross_sabr(F, T, atm, nu_x, rr25_target, pa, dfb):
    """Cross SABR: nu = propagated vol-of-vol, alpha so DNS ATM = atm, rho so 25 RR = target."""
    k_atm = (-0.5 if pa else 0.5) * atm * atm * T
    Katm = F * math.exp(k_atm)

    def make(r):
        # alpha*(1 + (r nu alpha/4 + ...)T) is not monotone for large alpha when r < 0, so bracket
        # the root closest to the ATM vol rather than over a wide range
        g = lambda a: float(sabr_vol(F, Katm, T, a, r, nu_x)) - atm
        hi = 1.5 * atm
        while g(hi) < 0 and hi < 8 * atm:
            hi *= 1.25
        a = brentq(g, 1e-6, hi, xtol=1e-14)
        return a, sabr_smile(F, T, a, r, nu_x, atm)

    def err(r):
        return rr25_on(make(r)[1], F, T, pa, dfb) - rr25_target

    note = ''
    lo, hi = -0.95, 0.95
    for _ in range(6):
        try:
            elo, ehi = err(lo), err(hi)
            break
        except ValueError:
            lo, hi = 0.8 * lo, 0.8 * hi
    else:
        raise ValueError('cross SABR: no admissible rho range')
    if elo * ehi <= 0:
        r = brentq(err, lo, hi, xtol=1e-8)
    else:
        r = lo if abs(elo) < abs(ehi) else hi
        note = 'cross SABR could not reach target 25 RR'
    a, sm = make(r)
    return {'alpha': a, 'rho': r, 'nu': nu_x, 'smile': sm, 'note': note}


# ======================================================================
# One tenor of the cross
# ======================================================================
def build_cross_tenor(legA, legB, rho_y, atm_anchor='formula', cross_pa=None, cross_dtype=None,
                      rho_sig=0.6, sig_rho=0.0, wings='vov', nk=41, span=5.0):
    """legA = leg holding the cross BASE ccy, legB = leg holding the QUOTE ccy.
    Always computes both wing models; `wings` picks which one is the output surface."""
    t0 = time.time()
    T = legA['T']
    MA, MB = Marginal(legA), Marginal(legB)
    cross = legA['ccy'] + legB['ccy']
    F = MA.FY / MB.FY
    S_YA = legA['S'] if legA['orient'] > 0 else 1.0 / legA['S']
    S_YB = legB['S'] if legB['orient'] > 0 else 1.0 / legB['S']
    S = S_YA / S_YB
    pa = default_premium_adjusted(cross) if cross_pa is None else cross_pa
    dtype = cross_dtype or default_delta_type(cross, T)
    dfb = legA['df_ccy'] if dtype == 'spot' else 1.0
    notes = []

    # ---- ATM + RR: Gaussian copula, ATM anchored to the variance formula by default
    vf = variance_formula(legA['atm'], legB['atm'], rho_y)
    rho_cop = rho_y
    Kf = dns_strike(F, T, vf['atm'], pa)
    raw_copula_atm = CrossPricer(MA, MB, rho_y, nz1=301, nw=801).iv(Kf, T)
    if atm_anchor == 'formula':
        def err(r):
            return CrossPricer(MA, MB, r, nz1=301, nw=801).iv(Kf, T) - vf['atm']
        try:
            if err(-0.995) * err(0.995) > 0:
                raise ValueError
            rho_cop = brentq(err, -0.995, 0.995, xtol=1e-6)
        except ValueError:
            notes.append('copula ATM calibration failed; used input rho')
            rho_cop = rho_y

    pr = CrossPricer(MA, MB, rho_cop)
    sd = vf['atm'] * math.sqrt(T)
    ks = np.linspace(-span, span, nk) * sd
    vols = np.array([pr.iv(F * math.exp(k), T) for k in ks])
    ok = np.isfinite(vols)
    if ok.sum() < 7:
        raise ValueError('too few valid cross vols')
    smile_cop = Smile(F, T, ks[ok], vols[ok])
    piv_cop = smile_pillars(smile_cop, F, T, pa, dfb)

    Kg = F * np.exp(ks[ok])
    cg = np.array([black(F, K, T, v, 1) for K, v in zip(Kg, vols[ok])])
    slope = np.diff(cg) / np.diff(Kg)
    arb_cross = int((np.diff(slope) < -1e-10 * F).sum() + (slope > 1e-9).sum())

    # ---- Wings: vol-of-vol propagation into a cross SABR
    labs = ['10P', '25P', 'ATM', '25C', '10C']
    sabr_a = fit_sabr(legA['F'], T, [legA['pillars'][l][0] for l in labs], [legA['pillars'][l][1] for l in labs])
    sabr_b = fit_sabr(legB['F'], T, [legB['pillars'][l][0] for l in labs], [legB['pillars'][l][1] for l in labs])
    vov = propagate_vov(legA['atm'], legB['atm'], rho_y, sabr_a['nu'], sabr_b['nu'], rho_sig, sig_rho)
    xs = cross_sabr(F, T, piv_cop['atm'], vov['nu_x'], piv_cop['rr25'], pa, dfb)
    if xs['note']:
        notes.append(xs['note'])
    piv_vov = smile_pillars(xs['smile'], F, T, pa, dfb)

    final, smile_final = (piv_vov, xs['smile']) if wings == 'vov' else (piv_cop, smile_cop)
    return {'tenor_T': T, 'cross': cross, 'S': S, 'F': F, 'pa': pa, 'dtype': dtype, 'wings': wings,
            'rho_y': rho_y, 'rho_copula': rho_cop, 'raw_copula_atm': raw_copula_atm, 'atm_anchor': atm_anchor,
            'formula': vf, 'res': final, 'res_copula': piv_cop, 'res_vov': piv_vov,
            'smile_obj': smile_final, 'smile_copula': smile_cop, 'smile_vov': xs['smile'],
            'curve_k': ks[ok].tolist(),
            'sabr_legs': [sabr_a, sabr_b], 'vov': vov, 'rho_sig': rho_sig, 'sig_rho': sig_rho,
            'sabr_cross': {k: xs[k] for k in ('alpha', 'rho', 'nu')},
            'notes': notes,
            'diag': {'fwd_err': pr.fwd_err, 'mean_err_A': MA.mean_err, 'mean_err_B': MB.mean_err,
                     'arb_leg_A': MA.arb_points, 'arb_leg_B': MB.arb_points,
                     'arb_cross': arb_cross, 'secs': time.time() - t0}}


# ======================================================================
# Full surface
# ======================================================================
def build_surface(legA_in, legB_in, rho_quoted_by_tenor, usd_rate=0.04, fly_conv='broker',
                  atm_anchor='formula', delta_mode='auto', tenors=None, today=None,
                  rho_sig_by_tenor=None, sig_rho_by_tenor=None, wings='vov', rho_half_life=0.5):
    """
    legX_in = {'pair': 'EURUSD', 'spot': 1.08, 'fwd_scale': 10000,
               'rows': {tenor: {'fwd_pts', 'atm', 'rr25', 'rr10', 'bf25', 'bf10'}}}
               (vols / RR / BF in VOL POINTS, fwd pts in pips — as on screen)
    rho_quoted_by_tenor = {tenor: correlation of the legs as quoted}
    rho_sig_by_tenor    = {tenor: correlation of the legs' vol moves}       (default 0.6)
    sig_rho_by_tenor    = {tenor: instantaneous annualized vol of rho}       (default 0.0)
    rho_half_life       = mean-reversion half-life of rho in years (None/0 = random walk)
    """
    rho_sig_by_tenor = rho_sig_by_tenor or {}
    sig_rho_by_tenor = sig_rho_by_tenor or {}
    pa_, pb_ = legA_in['pair'].upper(), legB_in['pair'].upper()
    base, quote = cross_ccys(pa_, pb_)
    if leg_info(pa_)[0] != base:
        legA_in, legB_in = legB_in, legA_in
    sA, sB = leg_info(legA_in['pair'])[1], leg_info(legB_in['pair'])[1]
    tenors = tenors or [t for t in TENORS if t in legA_in['rows'] and t in legB_in['rows']]
    dt = None if delta_mode == 'auto' else delta_mode
    out, errors = [], {}
    for t in tenors:
        try:
            T = tenor_to_T(t, today)
            df_usd = math.exp(-usd_rate * T)
            legs = []
            for L in (legA_in, legB_in):
                r = L['rows'][t]
                S = float(L['spot'])
                scale = float(L.get('fwd_scale') or pip_scale_from_spot(S))
                F = S + float(r.get('fwd_pts') or 0.0) / scale
                q = {k: float(r[k]) / 100.0 for k in ('atm', 'rr25', 'rr10', 'bf25', 'bf10')}
                bad = [k for k, v in q.items() if not math.isfinite(v)]
                if not (math.isfinite(S) and S > 0):
                    raise ValueError(f"{L['pair']} spot {S} is not a positive number")
                if not (math.isfinite(F) and F > 0) or abs(math.log(F / S)) > 0.4 + 0.5 * T:
                    raise ValueError(f"{L['pair']} {t} forward {F:.6g} vs spot {S:.6g} is implausible "
                                     f"(fwd pts {r.get('fwd_pts')}, scale {scale:g}) - check fwd points / scale")
                if bad or q['atm'] <= 0:
                    raise ValueError(f"{L['pair']} {t} bad quote(s): {bad or 'ATM <= 0'}")
                legs.append(build_leg(L['pair'].upper(), S, F, T, q, df_usd, fly_conv, dtype=dt))
            rq = float(rho_quoted_by_tenor[t])
            if not -1 < rq < 1:
                raise ValueError(f'rho {rq} must be strictly between -1 and 1 (decimal, not %)')
            rs = rho_sig_by_tenor.get(t)
            sr = sig_rho_by_tenor.get(t)
            sr = 0.0 if sr is None else float(sr)
            sr_eff = sr * ou_factor(T, rho_half_life)
            res = build_cross_tenor(legs[0], legs[1], sA * sB * rq, atm_anchor, cross_dtype=dt,
                                    rho_sig=0.6 if rs is None else float(rs), sig_rho=sr_eff, wings=wings)
            res['sig_rho_inst'] = sr
            if rs is None:
                res['notes'].append('vol-vol corr defaulted to 0.6')
            res['tenor'] = t
            res['rho_quoted'] = rq
            res['legs'] = [{'pair': l['pair'], 'pa': l['pa'], 'dtype': l['dtype'], 'F': l['F'],
                            'bs25': l['bs25'], 'bs10': l['bs10'],
                            'bf25_in': l['bf25_in'], 'bf10_in': l['bf10_in']} for l in legs]
            out.append(res)
        except Exception as e:
            errors[t] = f'{type(e).__name__}: {e}'

    cal_flags = []
    for a, b in zip(out, out[1:]):
        if b['res']['atm'] ** 2 * b['tenor_T'] < a['res']['atm'] ** 2 * a['tenor_T'] - 1e-10:
            cal_flags.append(f"{a['tenor']}->{b['tenor']}: ATM total variance decreases")
    return {'cross': base + quote, 'base': base, 'quote': quote,
            'leg_base': legA_in['pair'].upper(), 'leg_quote': legB_in['pair'].upper(),
            'sign_note': f'rho_Y = ({sA:+d})*({sB:+d})*rho_quoted',
            'tenors': out, 'errors': errors, 'calendar_flags': cal_flags}


# ======================================================================
# Realized estimators (spot correlation, vol-vol correlation, vol of correlation)
# ======================================================================
def realized_corr(px_a, px_b, pair_a, pair_b, windows=None):
    """px_a, px_b: aligned daily closes. Per-tenor rho as quoted and rho_Y."""
    windows = windows or CORR_WINDOW_BDAYS
    a = np.diff(np.log(np.asarray(px_a, float)))
    b = np.diff(np.log(np.asarray(px_b, float)))
    sA, sB = leg_info(pair_a)[1], leg_info(pair_b)[1]
    out = {}
    for t, n in windows.items():
        m = min(n, len(a))
        if m < 10:
            out[t] = {'window': n, 'n': m, 'rho_quoted': None, 'rho_y': None}
            continue
        r = float(np.corrcoef(a[-m:], b[-m:])[0, 1])
        if not math.isfinite(r):
            out[t] = {'window': n, 'n': m, 'rho_quoted': None, 'rho_y': None}
            continue
        out[t] = {'window': n, 'n': m, 'rho_quoted': r, 'rho_y': sA * sB * r}
    return out


def vol_vol_corr(vol_a, vol_b, window):
    """Correlation of daily log-changes of two aligned implied-vol series.
    Window floored at 63 business days (vol changes are noisy)."""
    a = np.diff(np.log(np.asarray(vol_a, float)))
    b = np.diff(np.log(np.asarray(vol_b, float)))
    m = min(max(window, 63), len(a))
    if m < 20:
        return None, m
    r = float(np.corrcoef(a[-m:], b[-m:])[0, 1])
    return (r if math.isfinite(r) else None), m


def corr_vol(px_a, px_b, block=21):
    """Annualized vol of the correlation itself (absolute rho units).
    Rho is estimated on consecutive non-overlapping blocks; the sampling noise of each
    block estimate, (1-rho^2)^2/(block-3), is removed from the variance of block-to-block changes:
        var(true d rho) = var(d rho_hat) - 2 * noise,   annualized x (252 / block)."""
    a = np.diff(np.log(np.asarray(px_a, float)))
    b = np.diff(np.log(np.asarray(px_b, float)))
    nb = len(a) // block
    if nb < 8:
        return {'value': None, 'n_blocks': nb}
    a, b = a[-nb * block:], b[-nb * block:]
    rhos = np.array([np.corrcoef(a[i * block:(i + 1) * block], b[i * block:(i + 1) * block])[0, 1]
                     for i in range(nb)])
    raw = float(np.var(np.diff(rhos), ddof=1))
    noise = float(np.mean((1 - rhos ** 2) ** 2)) / (block - 3)    # Fisher-z: var ~ 1/(n-3)
    true = max(raw - 2 * noise, 0.0)
    # mean reversion: lag-1 autocorrelation of the block series. Sampling noise inflates the
    # level variance but not the lag-1 covariance, so phi = cov1 / (var - noise).
    dev = rhos - rhos.mean()
    cov1 = float(np.mean(dev[1:] * dev[:-1]))
    lvl = float(np.var(rhos)) - noise
    half_life = None
    if lvl > 1e-6 and cov1 > 0:
        phi = min(cov1 / lvl, 0.999)
        half_life = min(max(math.log(2) / (-math.log(phi) / (block / 252)), 1 / 12), 3.0)
    return {'value': math.sqrt(true * 252 / block), 'raw': math.sqrt(raw * 252 / block),
            'n_blocks': nb, 'block': block, 'half_life': half_life}


# ======================================================================
# Implied correlation + correlation-trade analytics
# ----------------------------------------------------------------------
# Trading convention for these analytics: rho_Y = correlation of the two currencies' moves
# vs USD, i.e. the rho in  sX^2 = sA^2 + sB^2 - 2 rho_Y sA sB.
#   LONG correlation  = long rho_Y  = short cross vol, long leg vols (vega-neutral)
#                     = wins if realized rho_Y over the option's life ends ABOVE implied.
# (For EURCAD: rho_Y = corr(EUR vs USD, CAD vs USD) = -corr(EURUSD, USDCAD as quoted).)
# ======================================================================
TENOR_BDAYS = {'1W': 5, '2W': 10, '1M': 21, '2M': 42, '3M': 63, '6M': 126, '9M': 189,
               '1Y': 252, '18M': 378, '2Y': 504}


def implied_rho_y(sa, sb, sx):
    """Invert the variance formula: rho_Y implied by three ATM vols."""
    return (sa * sa + sb * sb - sx * sx) / (2 * sa * sb)


def rolling_corr(a, b, n):
    """Correlation of a[i-n:i], b[i-n:i] for every i (NaN until n points). O(len) via cumsums."""
    a, b = np.asarray(a, float), np.asarray(b, float)
    c = lambda x: np.concatenate([[0.0], np.cumsum(x)])
    sa, sb, saa, sbb, sab = c(a), c(b), c(a * a), c(b * b), c(a * b)
    out = np.full(len(a) + 1, np.nan)
    i = np.arange(n, len(a) + 1)
    ma, mb = (sa[i] - sa[i - n]) / n, (sb[i] - sb[i - n]) / n
    va = (saa[i] - saa[i - n]) / n - ma * ma
    vb = (sbb[i] - sbb[i - n]) / n - mb * mb
    cv = (sab[i] - sab[i - n]) / n - ma * mb
    with np.errstate(invalid='ignore', divide='ignore'):
        out[i] = cv / np.sqrt(va * vb)
    return out          # out[i] uses returns 0..i-1 (i.e. the n returns ending at observation i)


def corr_history(dates, spot_a, spot_b, vol_a, vol_b, vol_x, pair_a, pair_b, tenor):
    """Daily series (aligned dates) -> implied rho_Y, trailing realized, subsequent realized.
    trailing[t] = realized over the N returns ending at t (what you knew)
    forward[t]  = realized over the N returns after t (what the option actually lived through)."""
    n = TENOR_BDAYS[tenor]
    sA, sB = leg_info(pair_a)[1], leg_info(pair_b)[1]
    ra = sA * np.diff(np.log(np.asarray(spot_a, float)))     # returns of Y_A (USD value of ccy A)
    rb = sB * np.diff(np.log(np.asarray(spot_b, float)))
    va, vb, vx = (np.asarray(v, float) for v in (vol_a, vol_b, vol_x))
    implied = implied_rho_y(va, vb, vx)
    m = max(n, 5)
    rc = rolling_corr(ra, rb, m)                             # length len(dates)
    trailing = rc.copy()
    forward = np.full(len(dates), np.nan)
    forward[:len(dates) - m] = rc[m:]                         # realized over (t, t+m]
    return {'dates': list(dates), 'implied': implied, 'trailing': trailing, 'forward': forward,
            'vol_a': va, 'vol_b': vb, 'vol_x': vx, 'n': m, 'tenor': tenor}


def _pct(x, arr):
    arr = arr[np.isfinite(arr)]
    return float(np.mean(arr <= x) * 100) if len(arr) and math.isfinite(x) else None


def _stats(x):
    x = np.asarray(x, float)
    x = x[np.isfinite(x)]
    if len(x) == 0:
        return None
    sd = float(np.std(x, ddof=1)) if len(x) > 1 else 0.0
    return {'n': int(len(x)), 'mean': float(np.mean(x)), 'median': float(np.median(x)), 'std': sd,
            'p10': float(np.percentile(x, 10)), 'p90': float(np.percentile(x, 90)),
            'min': float(np.min(x)), 'max': float(np.max(x)),
            't': float(np.mean(x) / (sd / math.sqrt(len(x)))) if sd > 0 and len(x) > 1 else None,
            'hit': float(np.mean(x > 0) * 100)}


def corr_trade_stats(h):
    """Everything the long/short-correlation decision needs, from corr_history output."""
    imp, tr, fw, n = h['implied'], h['trailing'], h['forward'], h['n']
    va, vb, vx = h['vol_a'], h['vol_b'], h['vol_x']
    ok_now = np.where(np.isfinite(imp) & np.isfinite(tr))[0]
    if len(ok_now) == 0:
        return {'error': 'no overlapping implied / realized history'}
    i0 = ok_now[-1]
    imp_now, tr_now = float(imp[i0]), float(tr[i0])
    spread_now = imp_now - tr_now
    spread_hist = imp - tr
    imp_ok = imp[np.isfinite(imp)]

    # premium: implied minus what subsequently realized (rho points)
    prem = imp - fw
    # non-overlapping hold-to-expiry entries (one every n days), latest-first so the most recent
    # completed trade is always included
    valid = np.where(np.isfinite(imp) & np.isfinite(fw))[0]
    entries = valid[::-1][::n][::-1]
    long_rho = fw[entries] - imp[entries]                    # correlation-swap style P&L of long rho_Y
    # cross-vol equivalent: long rho_Y = short cross vol; d sigma_X / d rho_Y = -sA sB / sX
    dvol = (va * vb / vx)[entries]
    long_vol = long_rho * dvol                                # cross vol points earned per unit vega

    # conditional: days whose implied-trailing spread was at least as extreme as today's
    both = np.isfinite(imp) & np.isfinite(tr) & np.isfinite(fw)
    if spread_now >= 0:
        mask = both & (spread_hist >= spread_now)
    else:
        mask = both & (spread_hist <= spread_now)
    cond_n = int(mask.sum())
    cond = None
    if cond_n:
        cond = {'n': cond_n, 'short_hit': float(np.mean(fw[mask] < imp[mask]) * 100),
                'mean_prem': float(np.mean(imp[mask] - fw[mask])),
                'eff_n': max(1, cond_n // n)}               # overlapping days ~ cond_n / n independent
    z = (imp_now - float(np.mean(imp_ok))) / float(np.std(imp_ok)) if len(imp_ok) > 1 and np.std(imp_ok) > 0 else None
    sa, sb, sx = float(va[i0]), float(vb[i0]), float(vx[i0])
    vf = variance_formula(sa / 100, sb / 100, imp_now)
    return {
        'asof': str(h['dates'][i0]), 'tenor': h['tenor'], 'window': n,
        'now': {'implied': imp_now, 'trailing': tr_now, 'spread': spread_now,
                'implied_pct': _pct(imp_now, imp), 'spread_pct': _pct(spread_now, spread_hist),
                'implied_z': z, 'vol_a': sa, 'vol_b': sb, 'vol_x': sx,
                'd_sa': vf['d_sa'], 'd_sb': vf['d_sb'], 'dvol_drho': sa * sb / sx},
        'premium': _stats(prem),
        'backtest_long': {**(_stats(long_rho) or {}), 'vol': _stats(long_vol)},
        'backtest_entries': int(len(entries)),
        'conditional': cond,
        'implied_range': _stats(imp),
    }


def trade_construction(vega_x, sa, sb, sx, rho_y):
    """Vega-neutral correlation position for a cross vega notional (P&L per vol pt).
    Long rho_Y: sell vega_x of the cross, buy vega_x * dsX/dsA of leg A and vega_x * dsX/dsB of leg B.
    The leg hedges zero the position's sensitivity to leg vol moves (to first order), leaving
    P&L = vega_x * (sA sB / sX) * d rho_Y   (vols in vol points, rho_Y in correlation units)."""
    vf = variance_formula(sa, sb, rho_y)
    return {'cross_vega': -vega_x, 'leg_a_vega': vega_x * vf['d_sa'], 'leg_b_vega': vega_x * vf['d_sb'],
            'pnl_per_rho_point': vega_x * sa * sb / sx / 100.0}      # per +0.01 rho_Y


def synthetic_history(pair_a, pair_b, tenor, years=3, seed=None):
    """SYNTHETIC data for running without Bloomberg — NOT market data. True rho_Y follows an OU
    process (6M half-life); implied rho_Y = slow-moving view of it minus a premium, so the
    cross trades rich (the usual pattern); vols follow OU paths."""
    # stable seed (Python's hash() is randomized per process, which made the synthetic data change every run)
    rng = np.random.default_rng(seed if seed is not None else zlib.crc32(f'{pair_a}|{pair_b}|{tenor}'.encode()))
    nd = int(252 * years) + TENOR_BDAYS[tenor] + 5
    sA, sB = leg_info(pair_a)[1], leg_info(pair_b)[1]
    base_q = PLACEHOLDER_RHO.get((pair_a, pair_b), PLACEHOLDER_RHO.get((pair_b, pair_a), 0.3))
    base_y = sA * sB * base_q
    k = math.log(2) / 0.5 / 252
    rho = np.empty(nd)
    rho[0] = base_y
    for i in range(1, nd):
        rho[i] = rho[i - 1] + k * (base_y - rho[i - 1]) + 0.012 * rng.standard_normal()
    rho = np.clip(rho, -0.95, 0.95)
    pa_ = PLACEHOLDER_SURF.get(pair_a, (1.0, 8, 8, 0, 0))
    pb_ = PLACEHOLDER_SURF.get(pair_b, (1.0, 8, 8, 0, 0))

    def ou(level, sd):
        v = np.empty(nd)
        v[0] = level
        for i in range(1, nd):
            v[i] = v[i - 1] + 0.02 * (level - v[i - 1]) + sd * rng.standard_normal()
        return np.maximum(v, 0.3 * level)
    va, vb = ou(pa_[1], 0.12), ou(pb_[1], 0.10)
    g1, g2 = rng.standard_normal(nd), rng.standard_normal(nd)
    ya = va / 100 / math.sqrt(252) * g1
    yb = vb / 100 / math.sqrt(252) * (rho * g1 + np.sqrt(1 - rho ** 2) * g2)
    spot_a = pa_[0] * np.exp(sA * np.concatenate([[0], np.cumsum(ya[1:])]))
    spot_b = pb_[0] * np.exp(sB * np.concatenate([[0], np.cumsum(yb[1:])]))
    smooth = np.convolve(rho, np.ones(42) / 42, mode='full')[:nd]
    smooth[:42] = rho[:42]
    imp = np.clip(smooth - 0.06 + 0.03 * rng.standard_normal(nd), -0.97, 0.97)
    vx = np.sqrt(np.maximum(va ** 2 + vb ** 2 - 2 * imp * va * vb, 0.01))
    d0 = date.today() - timedelta(days=int(nd * 365 / 252))
    dates = [d0 + timedelta(days=int(i * 365 / 252)) for i in range(nd)]
    return dates, spot_a, spot_b, va, vb, vx


