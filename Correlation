function crossName(a,b){const ca=legCcy(a),cb=legCcy(b);if(ca===cb)return null;return RANK.indexOf(ca)<RANK.indexOf(cb)?ca+cb:cb+ca;}
async function api(path,opt){const r=await fetch(path,opt);const j=await r.json();if(!r.ok)throw new Error(j.error||r.statusText);return j;}

function segInit(){document.querySelectorAll('.seg').forEach(seg=>{const k=seg.dataset.k;
  seg.querySelectorAll('button').forEach(b=>{b.classList.toggle('on',S[k]===b.dataset.v);
   b.onclick=()=>{S[k]=b.dataset.v;seg.querySelectorAll('button').forEach(x=>x.classList.toggle('on',x===b));save();};});});}

function renderLeg(which){
  const L=S.legs[which],el=$('card'+which),pair=which==='A'?S.pairA:S.pairB;
  if(!L){el.innerHTML='<h2>'+pair+'</h2><div class="empty">loading…</div>';return;}
  let h='<h2>Leg '+which+' — '+L.pair+' <span class="badge '+L.source+'">'+L.source+'</span></h2>';
  h+='<div class="meta"><label>Spot <input class="num wide" data-k="spot" value="'+L.spot+'"></label>'
    +'<label>Fwd scale <input class="num" data-k="fwd_scale" value="'+L.fwd_scale+'"></label>'
    +(L.asof?'<span>as of '+L.asof+'</span>':'')+'</div>';
  h+='<div class="scroll"><table><thead><tr><th>Tenor</th>'+FIELDS.map(x=>'<th>'+x[1]+'</th>').join('')+'</tr></thead><tbody>';
  TENORS.forEach(t=>{const r=L.rows[t];h+='<tr><td class="lab">'+t+'</td>';
    FIELDS.forEach(([k])=>{const v=r?r[k]:'';h+='<td><input class="num" data-t="'+t+'" data-k="'+k+'" value="'+(v===null||v===undefined?'':v)+'"></td>';});
    h+='</tr>';});
  h+='</tbody></table></div>';
  if(L.note)h+='<div class="note '+(L.source==='PLACEHOLDER'?'warn':'')+'">'+L.note+'</div>';
  h+='<div class="note">RR = '+L.pair.slice(0,3)+' calls minus puts. Vols/RR/BF in vol points; fwd pts in pips (F = spot + pts / scale).</div>';
  el.innerHTML=h;
  el.querySelectorAll('input').forEach(inp=>inp.onchange=()=>{const v=parseFloat(inp.value);const k=inp.dataset.k;
    if(inp.dataset.t){L.rows[inp.dataset.t]=L.rows[inp.dataset.t]||{};L.rows[inp.dataset.t][k]=isFinite(v)?v:null;}else L[k]=v;
    inp.classList.add('dirty');save();});
}

function ovr(kind,t){const o=S.ov[kind][t];return (o!==undefined&&o!==null&&o!==''&&isFinite(o))?+o:null;}
function realized(kind,t){const C=S.corr;if(!C)return null;
  if(kind==='rho'){const c=C.by_tenor[t];return c&&c.rho_quoted!=null?c.rho_quoted:null;}
  if(kind==='rs'){const c=C.vol_vol&&C.vol_vol[t];return c&&c.rho_sig!=null?c.rho_sig:null;}
  return C.corr_vol&&C.corr_vol.value!=null?C.corr_vol.value:null;}
function orient(p){return p.slice(3)==='USD'?1:-1;}
function impliedQ(t){const M=S.mkt;if(!M||!M.rows||!M.rows[t]||!S.legs.A||!S.legs.B)return null;
  const ra=S.legs.A.rows[t],rb=S.legs.B.rows[t];if(!ra||!rb)return null;
  const a=+ra.atm,b=+rb.atm,x=+M.rows[t].atm;if(!(a>0&&b>0&&x>0))return null;
  return orient(S.legs.A.pair)*orient(S.legs.B.pair)*(a*a+b*b-x*x)/(2*a*b);}
function used(kind,t){const o=ovr(kind,t);if(o!==null)return o;
  if(kind==='rho'&&S.rho_src==='implied'){const i=impliedQ(t);if(i!==null&&Math.abs(i)<1)return i;}
  return realized(kind,t);}
function usedHL(){if(S.hl_ov!=null&&isFinite(S.hl_ov)&&S.hl_ov>0)return +S.hl_ov;const C=S.corr;return (C&&C.corr_vol&&C.corr_vol.half_life)||0.5;}
function renderCorr(){
  const el=$('cardC'),C=S.corr;
  let h='<h2>Correlation inputs — '+S.pairA+' vs '+S.pairB+(C?' <span class="badge '+C.source+'">'+C.source+'</span>':'')
    +'<span style="flex:1"></span><span style="font-weight:400;color:var(--text-secondary);font-size:11px">ρ used for the build</span>'
    +'<div class="seg" id="rhoSrc"><button data-v="implied">Implied (mkt cross ATM)</button><button data-v="realized">Realized</button></div></h2>';
  if(!C){el.innerHTML=h+'<div class="empty">loading…</div>';return;}
  if(C.from)h+='<div class="meta">BDH daily closes '+C.from+' → '+C.to+' ('+C.n_obs+' obs)'
    +(C.corr_vol&&C.corr_vol.n_blocks?' · vol of ρ from '+C.corr_vol.n_blocks+' blocks of '+C.corr_vol.block+'d (noise-corrected; raw '+f(C.corr_vol.raw,3)+')':'')+'</div>';
  h+='<div class="scroll"><table><thead><tr><th></th><th class="grp sep" colspan="5">Spot correlation ρ (legs as quoted)</th><th class="grp sep" colspan="3">Vol-vol correlation ρσ</th><th class="grp sep" colspan="3">Vol of correlation σρ (instantaneous, abs / yr)</th></tr>'
    +'<tr><th>Tenor</th><th class="sep">Window</th><th>Realized</th><th>Implied</th><th>Override</th><th>Used</th><th class="sep">Realized</th><th>Override</th><th>Used</th><th class="sep">Realized</th><th>Override</th><th>Used</th></tr></thead><tbody>';
  TENORS.forEach(t=>{const c=C.by_tenor[t]||{};
    const cell=k=>{const o=S.ov[k][t];return '<td><input class="num ovr" data-kind="'+k+'" data-t="'+t+'" value="'+(o===undefined||o===null?'':o)+'" placeholder="—"></td>';};
    const iq=impliedQ(t),bad=iq!==null&&Math.abs(iq)>=1;
    h+='<tr><td class="lab">'+t+'</td><td class="sep">'+(c.window||'')+'d</td><td>'+sgn(realized('rho',t),3)+'</td>'
     +'<td class="'+(bad?'err':'')+'" title="'+(bad?'|implied| >= 1: check leg / cross ATMs':'from market cross ATM')+'">'+sgn(iq,3)+'</td>'+cell('rho')+'<td class="hl">'+sgn(used('rho',t),3)+'</td>'
     +'<td class="sep">'+f(realized('rs',t),3)+'</td>'+cell('rs')+'<td class="hl">'+f(used('rs',t),3)+'</td>'
     +'<td class="sep">'+f(realized('sr',t),3)+'</td>'+cell('sr')+'<td class="hl">'+f(used('sr',t),3)+'</td></tr>';});
  h+='</tbody></table></div>';
  h+='<div class="note">ρ: log-return correlation of the legs as quoted; window = tenor in business days (min 21). '
    +'ρσ: correlation of daily log-changes of the two legs\' ATM vols at that tenor (window min 63d) — drives the cross vol-of-vol, hence the cross fly. '
    +'σρ: annualized vol of ρ itself — adds correlation risk to the cross vol-of-vol. Blank override = use realized.</div>';
  const hlR=C.corr_vol&&C.corr_vol.half_life;
  h+='<div class="meta" style="margin-top:8px">ρ mean-reversion half-life (yrs): realized '+(hlR?f(hlR,2):'n/a (default 0.50)')
    +' · override <input class="num" id="hlOv" value="'+(S.hl_ov==null?'':S.hl_ov)+'" placeholder="—"> · used <b style="color:var(--text-primary)">'+f(usedHL(),2)+'</b>'
    +' — σρ is scaled per tenor by √((1−e^(−2κT))/(2κT)), κ = ln2 / half-life</div>';
  if(C.note)h+='<div class="note warn">'+C.note+'</div>';
  el.innerHTML=h;
  el.querySelectorAll('input.ovr').forEach(inp=>inp.onchange=()=>{const v=inp.value.trim();
    S.ov[inp.dataset.kind][inp.dataset.t]=v===''?null:parseFloat(v);save();renderCorr();});
  $('hlOv').onchange=e=>{const v=e.target.value.trim();S.hl_ov=v===''?null:parseFloat(v);save();renderCorr();};
  document.querySelectorAll('#rhoSrc button').forEach(b=>{b.classList.toggle('on',S.rho_src===b.dataset.v);
    b.onclick=()=>{S.rho_src=b.dataset.v;save();renderCorr();};});
  if(S.mkt)el.insertAdjacentHTML('beforeend','<div class="note">Implied ρ backs out the variance formula from the market '+S.mkt.cross
    +' ATM and the two leg ATMs on screen: with "Implied" selected the generated ATM reproduces the market by construction. '
    +(S.mkt.source!=='BBG'?'<span class="warn">Cross quotes: '+S.mkt.source+' — '+(S.mkt.note||'')+'</span>':(S.mkt.note||''))+'</div>');
}

async function loadLeg(which){
  const pair=which==='A'?S.pairA:S.pairB;S.legs[which]=null;renderLeg(which);
  try{S.legs[which]=await api('/api/surface?pair='+pair);}catch(e){status('Surface '+pair+': '+e.message,'err');}
  renderLeg(which);save();
}
async function loadMkt(){try{S.mkt=await api('/api/cross_market?a='+S.pairA+'&b='+S.pairB);}catch(e){S.mkt=null;status('Cross quotes: '+e.message,'err');}
  renderCorr();save();}
async function loadCorr(){S.corr=null;renderCorr();
  try{S.corr=await api('/api/corr?a='+S.pairA+'&b='+S.pairB);}catch(e){status('Correlation: '+e.message,'err');}
  renderCorr();save();}
function updateCross(){const c=crossName(S.pairA,S.pairB);$('crossName').textContent=c||'same ccy';$('btnBuild').disabled=!c;}

async function build(){
  if(!S.legs.A||!S.legs.B){status('Legs not loaded','err');return;}
  const pick=k=>{const o={};TENORS.forEach(t=>{const v=used(k,t);if(v!==null)o[t]=v;});return o;};
  const legBody=L=>{const rows={};TENORS.forEach(t=>{const r=L.rows[t];if(r&&r.atm!==null&&isFinite(r.atm))rows[t]=r;});
    return {pair:L.pair,spot:+L.spot,fwd_scale:+L.fwd_scale,rows};};
  const body={legA:legBody(S.legs.A),legB:legBody(S.legs.B),rho:pick('rho'),rho_sig:pick('rs'),sig_rho:pick('sr'),rho_half_life:usedHL(),
    usd_rate:parseFloat($('usdRate').value)||0,fly_conv:S.fly_conv,wings:S.wings,atm_anchor:S.atm_anchor,delta_mode:S.delta_mode};
  status('Building '+crossName(S.pairA,S.pairB)+'…');$('btnBuild').disabled=true;
  try{S.result=await api('/api/build',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
    const R=S.result;if(!R.rows.find(r=>r.tenor===S.selTenor)&&R.rows.length)S.selTenor=R.rows[Math.min(4,R.rows.length-1)].tenor;
    const ne=Object.keys(R.errors).length;
    status('Built '+R.cross+' — '+R.rows.length+' tenors in '+R.secs+'s'+(ne?' · errors on '+Object.keys(R.errors).join(', '):''),ne?'warn':'');
    renderResults();}
  catch(e){status('Build failed: '+e.message,'err');}
  $('btnBuild').disabled=false;
}

