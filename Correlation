def log(msg):
    print(f"[{datetime.now():%H:%M:%S}] {msg}", flush=True)


class BBG:
    def __init__(self):
        self.session = None
        self.svc = None
        self.lock = threading.Lock()
        self.last_error = '' if blpapi else 'blpapi not installed'

    def available(self):
        with self.lock:
            return self._ensure()

    def _ensure(self):
        if self.session is not None:
            return True
        if blpapi is None:
            return False
        try:
            opts = blpapi.SessionOptions()
            opts.setServerHost(BBG_HOST)
            opts.setServerPort(BBG_PORT)
            s = blpapi.Session(opts)
            if not s.start():
                self.last_error = 'session start failed (is the Terminal running?)'
                return False
            if not s.openService('//blp/refdata'):
                self.last_error = 'could not open //blp/refdata'
                return False
            self.session, self.svc = s, s.getService('//blp/refdata')
            self.last_error = ''
            return True
        except Exception as e:
            self.last_error = str(e)
            return False

    def _drain(self, timeout_s=20):
        msgs, t_end = [], time.time() + timeout_s
        while time.time() < t_end:
            ev = self.session.nextEvent(500)
            for m in ev:
                msgs.append(m)
            if ev.eventType() == blpapi.Event.RESPONSE:
                return msgs
        raise TimeoutError('Bloomberg request timed out')

    def ref(self, tickers, fields):
        with self.lock:
            if not self._ensure():
                raise RuntimeError(self.last_error)
            req = self.svc.createRequest('ReferenceDataRequest')
            for t in tickers:
                req.getElement('securities').appendValue(t)
            for f in fields:
                req.getElement('fields').appendValue(f)
            self.session.sendRequest(req)
            out = {}
            for m in self._drain():
                if not m.hasElement('securityData'):
                    continue
                sd = m.getElement('securityData')
                for i in range(sd.numValues()):
                    s = sd.getValueAsElement(i)
                    tk = s.getElementAsString('security')
                    fd = s.getElement('fieldData')
                    out[tk] = {f: fd.getElementAsFloat(f) for f in fields if fd.hasElement(f)}
            return out

    def hist(self, tickers, field, start, end):
        with self.lock:
            if not self._ensure():
                raise RuntimeError(self.last_error)
            req = self.svc.createRequest('HistoricalDataRequest')
            for t in tickers:
                req.getElement('securities').appendValue(t)
            req.getElement('fields').appendValue(field)
            req.set('periodicitySelection', 'DAILY')
            # don't inherit terminal defaults: weekend/holiday fills would put zero returns in the
            # window and make a "21-row" window ~15 business days
            req.set('nonTradingDayFillOption', 'ACTIVE_DAYS_ONLY')
            req.set('nonTradingDayFillMethod', 'NIL_VALUE')
            req.set('startDate', start.strftime('%Y%m%d'))
            req.set('endDate', end.strftime('%Y%m%d'))
            self.session.sendRequest(req)
            out = {t: {} for t in tickers}
            for m in self._drain(60):
                if not m.hasElement('securityData'):
                    continue
                sd = m.getElement('securityData')
                tk = sd.getElementAsString('security')
                fd = sd.getElement('fieldData')
                for i in range(fd.numValues()):
                    row = fd.getValueAsElement(i)
                    if row.hasElement(field):
                        d = row.getElementAsDatetime('date')
                        out.setdefault(tk, {})[date(d.year, d.month, d.day)] = row.getElementAsFloat(field)
            return out


BB = BBG()


def _px(rec):
    if not rec:
        return None
    for f in ('PX_MID', 'PX_LAST'):
        v = rec.get(f)
        if v is not None and math.isfinite(v):
            return v
    return None


def placeholder_surface(pair):
    spot, a0, a1, rr1y, bf1y = PLACEHOLDER_SURF.get(pair, (1.0, 10.0, 10.0, 0.0, 0.25))
    base, quote = split_pair(pair)
    rb, rq = PLACEHOLDER_RATES.get(base, 3.0), PLACEHOLDER_RATES.get(quote, 3.0)
    scale = pip_scale_from_spot(spot)
    rows, n = {}, len(TENORS)
    for i, t in enumerate(TENORS):
        T = tenor_to_T(t)
        f = min(max(T ** 0.25, 0.5), 1.15)
        F = spot * math.exp((rq - rb) / 100 * T)
        rows[t] = {'fwd_pts': round((F - spot) * scale, 2), 'atm': round(a0 + (a1 - a0) * i / (n - 1), 3),
                   'rr25': round(rr1y * f, 3), 'rr10': round(1.85 * rr1y * f, 3),
                   'bf25': round(bf1y * f, 3), 'bf10': round(3.3 * bf1y * f, 3)}
    return {'pair': pair, 'spot': spot, 'fwd_scale': scale, 'rows': rows, 'source': 'PLACEHOLDER',
            'note': 'Placeholder values — not market data. ' + (BB.last_error or '')}


def bbg_surface(pair):
    ccy, _ = leg_info(pair)
    cands = FWD_TICKERS.get(ccy, [(ccy, 'points')])
    spot_tk = f'{pair} Curncy'
    tk = {'spot': spot_tk}
    for t in TENORS:
        tk[('atm', t)] = f'{pair}V{t} Curncy'
        tk[('rr25', t)] = f'{pair}25R{t} Curncy'
        tk[('rr10', t)] = f'{pair}10R{t} Curncy'
        tk[('bf25', t)] = f'{pair}25B{t} Curncy'
        tk[('bf10', t)] = f'{pair}10B{t} Curncy'
        for i, (pre, _) in enumerate(cands):
            tk[('fwd', t, i)] = f'{pre}{FWD_TENOR_SUFFIX.get(t, t)} Curncy'
    data = BB.ref(sorted(set(tk.values())), ['PX_MID', 'PX_LAST', 'FWD_SCALE'])
    spot = _px(data.get(spot_tk))
    if spot is None:
        raise RuntimeError(f'no spot for {spot_tk}')
    fs = None                                  # FWD_SCALE only means anything on a points ticker
    for t in TENORS:
        for i, (_, kind) in enumerate(cands):
            v = (data.get(tk[('fwd', t, i)]) or {}).get('FWD_SCALE')
            if kind == 'points' and v is not None and math.isfinite(v):
                fs = 10.0 ** v
                break
        if fs:
            break
    scale = fs or pip_scale_from_spot(spot)
    rows, missing, used = {}, [], set()
    for t in TENORS:
        r = {k: _px(data.get(tk[(k, t)])) for k in ('atm', 'rr25', 'rr10', 'bf25', 'bf10')}
        r['fwd_pts'] = None
        for i, (pre, kind) in enumerate(cands):
            v = _px(data.get(tk[('fwd', t, i)]))
            if v is not None:
                r['fwd_pts'] = fwd_to_points(v, spot, scale, kind)
                used.add(f'{pre} ({kind})')
                break
        if r['atm'] is None:
            missing.append(t)
            continue
        for k in ('rr25', 'rr10', 'bf25', 'bf10', 'fwd_pts'):
            if r[k] is None:
                r[k] = 0.0
                missing.append(f'{t} {k}')
        rows[t] = r
    notes = ['fwd tickers: ' + ', '.join(sorted(used))] if used else ['no forward ticker returned data']
    if missing:
        notes.append('Missing: ' + ', '.join(missing))
    return {'pair': pair, 'spot': spot, 'fwd_scale': scale, 'rows': rows, 'source': 'BBG',
            'note': ' · '.join(notes),
            'asof': datetime.now().strftime('%Y-%m-%d %H:%M:%S')}


def fwd_to_points(v, spot, scale, kind='auto'):
    """Convert a Bloomberg forward-ticker value to points.
    'points'   -> as is (EUR3M = 54.8 -> F = spot + 0.00548)
    'outright' -> (v - spot) * scale (BCN3M = 5.52 vs spot 5.40)
    'auto'     -> whichever reading puts F closer to spot (in log terms). Ambiguous only for
                  small-magnitude outright tickers, which is why NDFs are configured explicitly."""
    if v is None:
        return None
    if kind == 'points':
        return v
    if kind == 'outright':
        return (v - spot) * scale
    f_pts, f_out = spot + v / scale, v
    d_pts = abs(math.log(f_pts / spot)) if f_pts > 0 else float('inf')
    d_out = abs(math.log(f_out / spot)) if f_out > 0 else float('inf')
    return (v - spot) * scale if d_out < d_pts else v


def get_surface(pair):
    pair = pair.upper()
    if BB.available():
        try:
            return bbg_surface(pair)
        except Exception as e:
            log(f'BBG surface {pair} failed: {e}')
            BB.last_error = f'BBG pull failed: {e}'
    return placeholder_surface(pair)


def get_corr(a, b):
    """Spot correlation per tenor, vol-vol correlation per tenor, and vol of correlation."""
    a, b = a.upper(), b.upper()
    if BB.available():
        try:
            end = date.today()
            start = end - timedelta(days=365 * CORR_HISTORY_YEARS + 10)
            ta, tb = f'{a} Curncy', f'{b} Curncy'
            vtk = {(p, t): f'{p}V{t} Curncy' for p in (a, b) for t in TENORS}
            h = BB.hist([ta, tb] + list(vtk.values()), 'PX_LAST', start, end)
            dates = sorted(d for d in set(h.get(ta, {})) & set(h.get(tb, {})) if h[ta][d] > 0 and h[tb][d] > 0)
            if len(dates) < 30:
                raise RuntimeError(f'only {len(dates)} common spot dates')
            pa_ = [h[ta][d] for d in dates]
            pb_ = [h[tb][d] for d in dates]
            vv = {}
            for t in TENORS:
                ha, hb = h.get(vtk[(a, t)], {}), h.get(vtk[(b, t)], {})
                vd = sorted(d for d in set(ha) & set(hb) if ha[d] > 0 and hb[d] > 0)
                r, n = vol_vol_corr([ha[d] for d in vd], [hb[d] for d in vd], CORR_WINDOW_BDAYS[t]) \
                    if len(vd) > 30 else (None, len(vd))
                vv[t] = {'rho_sig': r, 'n': n}
            return {'source': 'BBG', 'from': dates[0].isoformat(), 'to': dates[-1].isoformat(),
                    'n_obs': len(dates), 'by_tenor': realized_corr(pa_, pb_, a, b),
                    'vol_vol': vv, 'corr_vol': corr_vol(pa_, pb_)}
        except Exception as e:
            log(f'BBG corr {a}/{b} failed: {e}')
            BB.last_error = f'BDH failed: {e}'
    v = PLACEHOLDER_RHO.get((a, b), PLACEHOLDER_RHO.get((b, a)))
    sA, sB = leg_info(a)[1], leg_info(b)[1]
    by = {t: {'window': n, 'n': 0, 'rho_quoted': v, 'rho_y': None if v is None else sA * sB * v}
          for t, n in CORR_WINDOW_BDAYS.items()}
    return {'source': 'PLACEHOLDER', 'by_tenor': by,
            'vol_vol': {t: {'rho_sig': PLACEHOLDER_VOL_VOL_CORR, 'n': 0} for t in TENORS},
            'corr_vol': {'value': PLACEHOLDER_CORR_VOL, 'n_blocks': 0, 'half_life': PLACEHOLDER_RHO_HALF_LIFE},
            'note': ('Placeholder correlations — not market data.' if v is not None
                     else 'No placeholder spot correlation for this pair — enter overrides.')}


def _clean(x):
    """JSON-safe list: NaN/inf -> None (Python json would emit NaN, which browsers reject)."""
    return [None if (v is None or not math.isfinite(float(v))) else round(float(v), 6) for v in x]


def cross_tickers(cross, t):
    return {'atm': f'{cross}V{t} Curncy', 'rr25': f'{cross}25R{t} Curncy', 'rr10': f'{cross}10R{t} Curncy',
            'bf25': f'{cross}25B{t} Curncy', 'bf10': f'{cross}10B{t} Curncy'}


def get_cross_market(a, b):
    """Market quotes for the cross itself (to back out implied correlation, and to compare the
    model's RR / flies against). Tries the cross both ways round; RR sign flips if inverted."""
    a, b = a.upper(), b.upper()
    base, quote = cross_ccys(a, b)
    names = [(base + quote, 1.0), (quote + base, -1.0)]
    if BB.available():
        try:
            tk = {(nm, t): cross_tickers(nm, t) for nm, _ in names for t in TENORS}
            allt = sorted({v for d in tk.values() for v in d.values()})
            data = BB.ref(allt, ['PX_MID', 'PX_LAST'])
            for nm, sgn in names:
                rows = {}
                for t in TENORS:
                    r = {k: _px(data.get(v)) for k, v in tk[(nm, t)].items()}
                    if r['atm'] is None:
                        continue
                    for k in ('rr25', 'rr10'):
                        if r[k] is not None:
                            r[k] *= sgn
                    rows[t] = r
                if rows:
                    return {'cross': base + quote, 'ticker_cross': nm, 'source': 'BBG', 'rows': rows,
                            'note': '' if sgn > 0 else f'quoted as {nm} on Bloomberg; RR sign flipped'}
            return {'cross': base + quote, 'source': 'BBG', 'rows': {},
                    'note': f'no Bloomberg vol tickers found for {base + quote} or {quote + base}'}
        except Exception as e:
            log(f'BBG cross {base + quote} failed: {e}')
            BB.last_error = f'cross pull failed: {e}'
    # PLACEHOLDER: market cross ATM priced with implied rho_Y 0.06 below the placeholder rho
    # (cross trades rich, the usual pattern) so the implied/realized machinery has something to show
    La, Lb = placeholder_surface(a), placeholder_surface(b)
    v = PLACEHOLDER_RHO.get((a, b), PLACEHOLDER_RHO.get((b, a), 0.3))
    rho_y = leg_info(a)[1] * leg_info(b)[1] * v - 0.06
    rows = {t: {'atm': round(math.sqrt(max(La['rows'][t]['atm'] ** 2 + Lb['rows'][t]['atm'] ** 2
                                           - 2 * rho_y * La['rows'][t]['atm'] * Lb['rows'][t]['atm'], 0.01)), 3),
                'rr25': None, 'rr10': None, 'bf25': None, 'bf10': None} for t in TENORS}
    return {'cross': base + quote, 'source': 'PLACEHOLDER', 'rows': rows,
            'note': 'Placeholder cross ATMs (not market data); no placeholder RR/BF.'}


def get_corr_history(a, b, tenor, years):
    a, b = a.upper(), b.upper()
    base, quote = cross_ccys(a, b)
    src, note = 'SYNTHETIC', 'SYNTHETIC history (no Bloomberg) — illustrates the tool, not the market.'
    series = None
    if BB.available():
        try:
            end = date.today()
            start = end - timedelta(days=int(365 * years) + 400)       # extra for the forward window
            tks = {'sa': f'{a} Curncy', 'sb': f'{b} Curncy', 'va': f'{a}V{tenor} Curncy',
                   'vb': f'{b}V{tenor} Curncy'}
            xn = [(base + quote), (quote + base)]
            h = BB.hist(list(tks.values()) + [f'{x}V{tenor} Curncy' for x in xn], 'PX_LAST', start, end)
            hx = next((h[f'{x}V{tenor} Curncy'] for x in xn if h.get(f'{x}V{tenor} Curncy')), {})
            if not hx:
                raise RuntimeError(f'no history for {base + quote}V{tenor} (either orientation)')
            dates = sorted(d for d in set(h[tks['sa']]) & set(h[tks['sb']]) if h[tks['sa']][d] > 0 and h[tks['sb']][d] > 0)
            if len(dates) < TENOR_BDAYS[tenor] + 40:
                raise RuntimeError(f'only {len(dates)} common spot dates')
            g = lambda src_, d: src_[d] if src_.get(d) and src_[d] > 0 else float('nan')
            series = (dates, [h[tks['sa']][d] for d in dates], [h[tks['sb']][d] for d in dates],
                      [g(h[tks['va']], d) for d in dates], [g(h[tks['vb']], d) for d in dates], [g(hx, d) for d in dates])
            gaps = sum(1 for d in dates if not (hx.get(d) and h[tks['va']].get(d) and h[tks['vb']].get(d)))
            src, note = 'BBG', f'BDH {dates[0]} -> {dates[-1]}, {len(dates)} spot days' + (f', implied missing on {gaps}' if gaps else '')
        except Exception as e:
            log(f'BBG corr history failed: {e}')
            note = f'Bloomberg history unavailable ({e}); showing SYNTHETIC data.'
    if series is None:
        series = synthetic_history(a, b, tenor, years)
    hist = corr_history(*series, a, b, tenor)
    # keep the requested lookback for display/stats, but the forward window needs no trimming:
    # forward realized is simply NaN for the last N days
    cut = max(0, len(hist['dates']) - int(252 * years))
    for k in ('implied', 'trailing', 'forward', 'vol_a', 'vol_b', 'vol_x'):
        hist[k] = hist[k][cut:]
    hist['dates'] = hist['dates'][cut:]
    stats = corr_trade_stats(hist)
    return {'cross': base + quote, 'tenor': tenor, 'source': src, 'note': note, 'window': hist['n'], 'window_trail': hist['n_trail'],
            'sign_note': f'rho_Y = corr({base} vs USD, {quote} vs USD); long correlation = short {base + quote} vol vs legs',
            'dates': [str(d) for d in hist['dates']], 'implied': _clean(hist['implied']),
            'trailing': _clean(hist['trailing']), 'forward': _clean(hist['forward']), 'stats': stats}


def get_corr_monitor(a, b, tenor='1M', window=21, ma=5, years=1.0, days=21):
    a, b = a.upper(), b.upper()
    base, quote = cross_ccys(a, b)
    src, note = 'SYNTHETIC', 'SYNTHETIC history (no Bloomberg) — illustrates the tool, not the market.'
    pulled = None
    if BB.available():
        try:
            end = date.today()
            start = end - timedelta(days=int(365 * max(years, 3.0)) + 120)    # diagnostics use >= 3y
            xn = [base + quote, quote + base]
            tks = [f'{a} Curncy', f'{b} Curncy', f'{a}V{tenor} Curncy', f'{b}V{tenor} Curncy'] \
                + [f'{x} Curncy' for x in xn] + [f'{x}V{tenor} Curncy' for x in xn]
            h = BB.hist(tks, 'PX_LAST', start, end)
            sa_, sb_ = h.get(f'{a} Curncy', {}), h.get(f'{b} Curncy', {})
            dates = sorted(d for d in set(sa_) & set(sb_) if sa_[d] > 0 and sb_[d] > 0)
            if len(dates) < window + 30:
                raise RuntimeError(f'only {len(dates)} common spot dates')
            vx_d, vx_nm = next(((h[f'{x}V{tenor} Curncy'], x) for x in xn if h.get(f'{x}V{tenor} Curncy')), ({}, None))
            xs_d, xs_inv = {}, False
            if h.get(f'{xn[0]} Curncy'):
                xs_d = h[f'{xn[0]} Curncy']
            elif h.get(f'{xn[1]} Curncy'):
                xs_d, xs_inv = h[f'{xn[1]} Curncy'], True
            g = lambda d_, k: d_[k] if d_.get(k) and d_[k] > 0 else float('nan')
            va = np.array([g(h.get(f'{a}V{tenor} Curncy', {}), d) for d in dates])
            vb = np.array([g(h.get(f'{b}V{tenor} Curncy', {}), d) for d in dates])
            vx = np.array([g(vx_d, d) for d in dates])
            xs = np.array([g(xs_d, d) for d in dates])
            if xs_inv:
                xs = 1 / xs
            pulled = (dates, [sa_[d] for d in dates], [sb_[d] for d in dates], va, vb, vx, xs)
            miss = int(np.sum(~np.isfinite(vx)))
            src, note = 'BBG', (f'BDH {dates[0]} -> {dates[-1]}, {len(dates)} spot days'
                                + (f'; implied missing on {miss}' if miss else '')
                                + ('' if vx_nm else f'; no {base + quote}V{tenor} history (implied unavailable)'))
        except Exception as e:
            log(f'BBG corr monitor failed: {e}')
            note = f'Bloomberg history unavailable ({e}); showing SYNTHETIC data.'
    if pulled is None:
        dates, pa_, pb_, va, vb, vx = synthetic_history(a, b, tenor, max(years, 3.0) + 0.5)
        sA, sB = leg_info(a)[1], leg_info(b)[1]
        ya = np.asarray(pa_) if sA > 0 else 1 / np.asarray(pa_)
        yb = np.asarray(pb_) if sB > 0 else 1 / np.asarray(pb_)
        if leg_info(a)[0] != base:
            ya, yb = yb, ya
        pulled = (dates, pa_, pb_, np.asarray(va), np.asarray(vb), np.asarray(vx), ya / yb)
    dates, pa_, pb_, va, vb, vx, xs = pulled
    with np.errstate(invalid='ignore'):
        imp = implied_rho_y(np.asarray(va, float), np.asarray(vb, float), np.asarray(vx, float))
    # monitor works in (base leg, quote leg) order so the cross check is in base/quote units
    if leg_info(a)[0] != base:
        a2, b2, p1, p2 = b, a, pb_, pa_
    else:
        a2, b2, p1, p2 = a, b, pa_, pb_
    M = corr_monitor(dates, p1, p2, imp, a2, b2, window=window, ma=ma, days=days, cross_spot=xs)
    cut = max(0, len(M['dates']) - int(252 * years))
    ser = {k: _clean(M[k][cut:]) for k in ('implied', 'realized', 'realized_pearson', 'ma_implied', 'ma_realized')}
    clean_row = lambda r: {k: (round(v, 6) if isinstance(v, float) and math.isfinite(v) else
                               (None if isinstance(v, float) else v)) for k, v in r.items()}
    out = {'cross': base + quote, 'leg_base': a2, 'leg_quote': b2, 'tenor': tenor, 'source': src, 'note': note,
           'window': window, 'ma': ma, 'dates': M['dates'][cut:], **ser,
           'rows': [clean_row(r) for r in M['rows']],
           'diag': {k: (v if not isinstance(v, float) or math.isfinite(v) else None) for k, v in M['diag'].items()},
           'noise_implied': M['noise_implied'], 'noise_realized_dd': M['noise_realized_dd'],
           'sampling_sd': M['sampling_sd'],
           'sign_note': f'rho = corr({base} vs USD, {quote} vs USD), zero-mean over {window} daily returns'}
    return out


