def main():
    ap = argparse.ArgumentParser(description='Cross Vol Builder')
    ap.add_argument('--port', type=int, default=8090)
    ap.add_argument('--no-browser', action='store_true')
    ap.add_argument('--selftest', action='store_true', help='run the numerical checks and exit')
    args = ap.parse_args()
    if args.selftest:
        raise SystemExit(0 if selftest() else 1)
    srv = ThreadingHTTPServer(('127.0.0.1', args.port), Handler)
    url = f'http://localhost:{args.port}'
    log(f'Cross Vol Builder on {url}  (Bloomberg: {"available" if BB.available() else "offline — " + BB.last_error})')
    if not args.no_browser:
        threading.Timer(0.8, lambda: webbrowser.open(url)).start()
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        log('shutting down')


if __name__ == '__main__':
    main()
