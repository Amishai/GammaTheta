    check('placeholder cross ATM implies rho_Y = placeholder - 0.06', abs(iy - (0.45 - 0.06)) < 0.003, f'({iy:+.4f})')

    print(f"\n{sum(results)}/{len(results)} checks passed")
    return all(results)


