def selftest():
    """python cross_vol.py --selftest   — numerical checks with the numbers they compare."""
    T0 = date(2026, 10, 21)
    results = []

    def check(name, ok, detail=''):
        results.append(bool(ok))
        print(f"  [{'OK ' if ok else 'FAIL'}] {name} {detail}")

    def rows_flat(atm, pts=0.0, tenors=TENORS):
        return {t: {'fwd_pts': pts, 'atm': atm, 'rr25': 0.0, 'rr10': 0.0, 'bf25': 0.0, 'bf10': 0.0} for t in tenors}

    def zm_ref(x, y):            # zero-mean realized correlation, written out independently
        x, y = np.asarray(x, float), np.asarray(y, float)
        return float(np.dot(x, y) / math.sqrt(np.dot(x, x) * np.dot(y, y)))

    print('\n1) Lognormal limit: flat smiles -> flat cross, ATM = variance formula (both wing models)')
    A = {'pair': 'EURUSD', 'spot': 1.08, 'fwd_scale': 10000, 'rows': rows_flat(7.5, 20)}
    B = {'pair': 'USDCAD', 'spot': 1.37, 'fwd_scale': 10000, 'rows': rows_flat(6.0, -15)}
    for wings in ('copula', 'vov'):
        s = build_surface(A, B, {t: -0.45 for t in TENORS}, fly_conv='smile', atm_anchor='copula',
                          tenors=['1M', '1Y', '2Y'], today=T0, wings=wings)
        for r in s['tenors']:
            v = r['res']
            check(f"{wings:6} {r['tenor']:>2} ATM {v['atm']*100:.4f} vs formula {r['formula']['atm']*100:.4f}, flat smile",
                  abs(v['atm'] - r['formula']['atm']) < 3e-4 and
                  max(abs(v['rr25']), abs(v['bf25s']), abs(v['rr10']), abs(v['bf10s'])) < 3e-4,
                  f"(RR25 {v['rr25']*100:+.4f} BF25 {v['bf25s']*100:+.4f})")
    print(f"   hand calc sqrt(7.5^2 + 6^2 + 2(-0.45)(7.5)(6)) = {math.sqrt(51.75):.4f}")

    print('\n2) Leg smile survives the USD-measure change (reprice pillars from the marginal)')
    for pair, S0, pts, q in [('USDCAD', 1.37, -40, dict(atm=0.060, rr25=0.006, rr10=0.011, bf25=0.0025, bf10=0.008)),
                             ('EURUSD', 1.08, 60, dict(atm=0.075, rr25=-0.004, rr10=-0.007, bf25=0.0020, bf10=0.0065))]:
        Tt = tenor_to_T('6M', T0)
        F = S0 + pts / 1e4
        leg = build_leg(pair, S0, F, Tt, q, math.exp(-0.04 * Tt), 'smile')
        M = Marginal(leg)
        z = np.linspace(-9, 9, 200001)
        w = npdf(z) * (z[1] - z[0])
        Y = M.Q(z)
        worst = 0.0
        for lab, (K, vin) in leg['pillars'].items():
            if leg['orient'] < 0:
                c, p = F * np.sum(w * np.maximum(1 - K * Y, 0)), F * np.sum(w * np.maximum(K * Y - 1, 0))
            else:
                c, p = np.sum(w * np.maximum(Y - K, 0)), np.sum(w * np.maximum(K - Y, 0))
            iv = implied_vol(c, F, K, Tt, 1) if K >= F else implied_vol(p, F, K, Tt, -1)
            worst = max(worst, abs(iv - vin))
        check(f'{pair} pillars recovered', worst < 5e-4, f'(worst {worst*100:.4f} vol)')

    print('\n3) Broker <-> smile fly')
    Tt = tenor_to_T('3M', T0)
    q = dict(atm=0.075, rr25=-0.010, rr10=-0.019, bf25=0.0030, bf10=0.0095)
    leg = build_leg('EURUSD', 1.08, 1.0830, Tt, q, math.exp(-0.04 * Tt), 'broker')
    b25 = broker_fly_from_smile(leg['smile'], 1.0830, Tt, q['atm'], 0.25, leg['pa'], leg['dfb'])
    b10 = broker_fly_from_smile(leg['smile'], 1.0830, Tt, q['atm'], 0.10, leg['pa'], leg['dfb'])
    check('round trip', abs(b25 - q['bf25']) < 1e-6 and abs(b10 - q['bf10']) < 1e-6,
          f"(0.300/0.950 -> smile {leg['bs25']*100:.3f}/{leg['bs10']*100:.3f} -> {b25*100:.4f}/{b10*100:.4f})")
    check('smile fly > broker fly when RR != 0', leg['bs25'] > q['bf25'])
    leg0 = build_leg('EURUSD', 1.08, 1.0830, Tt, dict(q, rr25=0.0, rr10=0.0), math.exp(-0.04 * Tt), 'broker')
    check('smile fly = broker fly when RR = 0', abs(leg0['bs25'] - q['bf25']) < 2e-5)

    print('\n4) Leg order, forward, JPY orientation')
    A = {'pair': 'EURUSD', 'spot': 1.08, 'fwd_scale': 10000,
         'rows': {'3M': dict(fwd_pts=28, atm=7.5, rr25=-0.80, rr10=-1.45, bf25=0.25, bf10=0.85)}}
    B = {'pair': 'USDCAD', 'spot': 1.37, 'fwd_scale': 10000,
         'rows': {'3M': dict(fwd_pts=-36, atm=6.0, rr25=0.55, rr10=1.00, bf25=0.22, bf10=0.72)}}
    s1 = build_surface(A, B, {'3M': -0.45}, today=T0, rho_sig_by_tenor={'3M': 0.5})
    s2 = build_surface(B, A, {'3M': -0.45}, today=T0, rho_sig_by_tenor={'3M': 0.5})
    d = max(abs(s1['tenors'][0]['res'][k] - s2['tenors'][0]['res'][k]) for k in ('atm', 'rr25', 'bf25b', 'bf10b'))
    check('leg order irrelevant', d < 1e-9, f'(max diff {d:.1e})')
    check('cross forward = F_EURUSD x F_USDCAD', abs(s1['tenors'][0]['F'] - 1.0828 * 1.3664) < 1e-12)
    J = {'pair': 'USDJPY', 'spot': 150.0, 'fwd_scale': 100, 'rows': rows_flat(9.5, -120, ['3M'])}
    for X, rq, name in [({'pair': 'EURUSD', 'spot': 1.08, 'fwd_scale': 10000, 'rows': rows_flat(7.5, 28, ['3M'])}, -0.30, 'EURJPY'),
                        ({'pair': 'USDCAD', 'spot': 1.37, 'fwd_scale': 10000, 'rows': rows_flat(6.0, -36, ['3M'])}, 0.25, 'CADJPY')]:
        s = build_surface(X, J, {'3M': rq}, fly_conv='smile', today=T0)
        sA, sB = leg_info(s['leg_base'])[1], leg_info(s['leg_quote'])[1]
        hand = math.sqrt(X['rows']['3M']['atm'] ** 2 + 9.5 ** 2 - 2 * sA * sB * rq * X['rows']['3M']['atm'] * 9.5)
        check(f'{name} name & ATM', s['cross'] == name and abs(s['tenors'][0]['res']['atm'] * 100 - hand) < 0.02,
              f"({s['tenors'][0]['res']['atm']*100:.3f} vs {hand:.3f})")

    print('\n5) SABR fit recovers known parameters from 5 delta pillars')
    Tt = tenor_to_T('3M', T0)
    F = 1.0830
    true = (0.075, -0.25, 1.10)
    sm = sabr_smile(F, Tt, *true, 0.075)
    Ks, vs = [], []
    for d_, cp in ((0.10, -1), (0.25, -1), (0.25, 1), (0.10, 1)):
        k, v = delta_strike_on_smile(sm, F, Tt, d_, cp, False, 1.0, 0.075 * math.sqrt(Tt))
        Ks.append(F * math.exp(k))
        vs.append(v)
    ka, va = dns_self_consistent(sm, Tt, False)
    Ks.insert(2, F * math.exp(ka))
    vs.insert(2, va)
    fit = fit_sabr(F, Tt, Ks, vs)
    check('SABR (alpha, rho, nu) recovered', abs(fit['alpha'] - true[0]) < 2e-4 and abs(fit['rho'] - true[1]) < 0.01
          and abs(fit['nu'] - true[2]) < 0.01,
          f"(fit {fit['alpha']*100:.3f}/{fit['rho']:+.3f}/{fit['nu']:.3f} vs 7.500/-0.250/1.100)")

    print('\n6) Vol-of-vol propagation identities')
    p = propagate_vov(0.075, 0.060, 0.45, 1.08, 1.13, 1.0, 0.0)
    wavg = p['w_a'] * 1.08 + p['w_b'] * 1.13
    check('weights sum to 1', abs(p['w_a'] + p['w_b'] - 1) < 1e-12, f"({p['w_a']:.4f} + {p['w_b']:.4f})")
    check('rho_sig = 1, no corr vol -> nu_X = weighted average', abs(p['nu_x'] - wavg) < 1e-12,
          f"({p['nu_x']:.4f} vs {wavg:.4f})")
    p0 = propagate_vov(0.075, 0.060, 0.45, 1.08, 1.13, 0.3, 0.0)
    p1 = propagate_vov(0.075, 0.060, 0.45, 1.08, 1.13, 0.3, 0.25)
    check('nu_X rises with vol-vol corr and with corr vol', p0['nu_x'] < p['nu_x'] and p1['nu_x'] > p0['nu_x'],
          f"({p0['nu_x']:.3f} -> {p['nu_x']:.3f}; +corr vol {p1['nu_x']:.3f})")

    print('\n7) Cross SABR hits its ATM and 25 RR targets; fly rises with vol-vol corr')
    xs = cross_sabr(1.4887, Tt, 0.07192, 0.97, -0.00195, True, 1.0)
    pv = smile_pillars(xs['smile'], 1.4887, Tt, True, 1.0)
    check('ATM & RR25 matched', abs(pv['atm'] - 0.07192) < 2e-5 and abs(pv['rr25'] + 0.00195) < 2e-5,
          f"(ATM {pv['atm']*100:.4f}, RR25 {pv['rr25']*100:+.4f}, rho {xs['rho']:+.3f})")
    flies = []
    for rs in (0.3, 0.6, 0.9):
        s = build_surface(A, B, {'3M': -0.45}, today=T0, rho_sig_by_tenor={'3M': rs})
        flies.append(s['tenors'][0]['res']['bf25b'] * 100)
    cop = s['tenors'][0]['res_copula']['bf25b'] * 100
    check('25 BF increasing in rho_sig and above Gaussian copula', flies[0] < flies[1] < flies[2] and flies[0] > cop,
          f"(rho_sig .3/.6/.9 -> {flies[0]:.3f}/{flies[1]:.3f}/{flies[2]:.3f}; copula {cop:.3f})")

    print('\n8) Realized estimators')
    rng = np.random.default_rng(7)
    n = 756
