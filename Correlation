class Handler(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def _send(self, code, payload, ctype='application/json'):
        data = payload if isinstance(payload, bytes) else json.dumps(payload, default=_jsonable).encode()
        self.send_response(code)
        self.send_header('Content-Type', ctype)
        self.send_header('Cache-Control', 'no-store')
        self.send_header('Content-Length', str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        u = urlparse(self.path)
        q = {k: v[0] for k, v in parse_qs(u.query).items()}
        try:
            if u.path in ('/', '/index.html'):
                self._send(200, HTML.encode(), 'text/html; charset=utf-8')
            elif u.path == '/api/status':
                self._send(200, {'bbg': BB.available(), 'error': BB.last_error, 'pairs': LEG_PAIRS,
                                 'tenors': TENORS, 'windows': CORR_WINDOW_BDAYS})
            elif u.path == '/api/surface':
                self._send(200, get_surface(q['pair']))
            elif u.path == '/api/corr':
                self._send(200, get_corr(q['a'], q['b']))
            elif u.path == '/api/cross_market':
                self._send(200, get_cross_market(q['a'], q['b']))
            elif u.path == '/api/corr_history':
                self._send(200, get_corr_history(q['a'], q['b'], q.get('tenor', '3M'), float(q.get('years', 3))))
            else:
                self._send(404, {'error': 'not found'})
        except Exception as e:
            log(traceback.format_exc())
            self._send(500, {'error': f'{type(e).__name__}: {e}'})

    def do_POST(self):
        try:
            n = int(self.headers.get('Content-Length', 0))
            body = json.loads(self.rfile.read(n) or b'{}')
            if urlparse(self.path).path == '/api/build':
                res = run_build(body)
                log(f"built {res['cross']} {len(res['rows'])} tenors in {res['secs']}s"
                    + (f" errors={res['errors']}" if res['errors'] else ''))
                self._send(200, res)
            else:
                self._send(404, {'error': 'not found'})
        except Exception as e:
            log(traceback.format_exc())
            self._send(500, {'error': f'{type(e).__name__}: {e}'})


def _jsonable(o):
    if isinstance(o, np.floating):
        return float(o)
    if isinstance(o, np.integer):
        return int(o)
    if isinstance(o, (date, datetime)):
        return o.isoformat()
    raise TypeError(type(o))


