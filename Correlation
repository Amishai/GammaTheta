          abs(best[1] - mA) < 0.006 and abs(best[2] - mB) < 0.006,
          f'(formula {mA:.4f}/{mB:.4f}, grid {best[1]:.4f}/{best[2]:.4f})')
    rng5 = np.random.default_rng(3)
    L5 = np.linalg.cholesky(Sig_i)
    z = rng5.standard_normal((400000, 2)) @ L5.T
    for mode in ('corr', 'minvar'):
        rA_, rB_ = gamma_hedge_ratios(sa, sb, ry, mode)
        hb = hedge_book(Gx, -rA_ * Gx, -rB_ * Gx, sa, sb, ry)
        pn = 0.5 * np.einsum('ij,jk,ik->i', z, hb['M'], z)
        check(f'{mode:6} residual daily P&L sd: formula = Monte Carlo', abs(np.std(pn) / hb['resid_sd'] - 1) < 0.02,
              f"(USD {hb['resid_sd']:,.0f} vs {np.std(pn):,.0f}; unhedged {hb['unhedged_sd']:,.0f})")

    print(f"\n{sum(results)}/{len(results)} checks passed")
    return all(results)


# ######################################################################
#                                 MAIN
# ######################################################################
def main():
    ap = argparse.ArgumentParser(description='Cross Vol Builder')
    ap.add_argument('--port', type=int, default=8090)
    ap.add_argument('--no-browser', action='store_true')
    ap.add_argument('--selftest', action='store_true', help='run the numerical checks and exit')
    args = ap.parse_args()
    if args.selftest:
        raise SystemExit(0 if selftest() else 1)
    srv = ThreadingHTTPServer(('127.0.0.1', args.port), Handler)
    url = f'http://localhost:{args.port}'
    log(f'Cross Vol Builder on {url}  (Bloomberg: {"available" if BB.available() else "offline — " + BB.last_error})')
    if not args.no_browser:
        threading.Timer(0.8, lambda: webbrowser.open(url)).start()
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        log('shutting down')


if __name__ == '__main__':
    main()
