function parseCell(s){
  let t=String(s==null?'':s).trim().replace(/[−–—]/g,'-').replace(/[,\s%$]/g,'');
  if(t==='')return null;
  let neg=false;const m=t.match(/^\((.*)\)$/);if(m){neg=true;t=m[1];}
  if(!/^[-+]?(\d+\.?\d*|\.\d+)(e[-+]?\d+)?$/i.test(t))return NaN;
  const v=parseFloat(t);return neg?-v:v;
