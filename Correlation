def leg_for_ccy(ccy):
    return next((p for p in LEG_PAIRS if leg_info(p)[0] == ccy), None)


def cross_to_legs(cross):
    """'EURJPY' -> ('EURUSD', 'USDJPY'); None if a currency has no USD leg here."""
    cross = cross.strip().upper()
    if len(cross) != 6:
        return None
    a, b = leg_for_ccy(cross[:3]), leg_for_ccy(cross[3:])
    return (a, b) if a and b and a != b else None


def universe_combos():
    if UNIVERSE['mode'] == 'used':
        return set()
    out = {(p, None) for p in LEG_PAIRS}
    if UNIVERSE['mode'] == 'all':
        out |= {(LEG_PAIRS[i], LEG_PAIRS[j]) for i in range(len(LEG_PAIRS)) for j in range(i + 1, len(LEG_PAIRS))}
    else:
        out |= {cross_to_legs(c) for c in UNIVERSE['crosses'] if cross_to_legs(c)}
    return out


