let _loadingAll=false;
async function loadAll(){
  if(_loadingAll)return;_loadingAll=true;const btn=$('btnAll');btn.disabled=true;
  if(_autoBusy)await _syncDone;                // let a fill from the shared data finish first
  const t0=performance.now(),probs=[];
  const step=(i,txt)=>status('Load all '+i+'/6 · '+txt+'…');
  try{
    step(1,'Bloomberg legs + implied ρ');
    const ok=await refreshMarket();if(ok==='cancel'){status('Load all cancelled');return;}if(ok===false)probs.push('market refresh');
    if(!S.legs.A||!S.legs.B){status('Load all stopped: legs not loaded','err');return;}
    step(2,'realized correlation');await loadCorr();if(!S.corr)probs.push('realized correlation');
    step(3,'cross surface');S.result=null;await build();if(!S.result)probs.push('cross surface');
    step(4,'triangle & hedge');renderTri();
    step(5,'correlation monitor');S.monData=null;await loadMon();if(!S.monData)probs.push('monitor');
    step(6,'analytics history');S.hist=null;await loadHist();if(!S.hist)probs.push('analytics');
    const secs=((performance.now()-t0)/1000).toFixed(1);
    status(probs.length?'Loaded with problems in: '+probs.join(', ')+' ('+secs+'s)':'Loaded everything for '+crossNm()+' in '+secs+'s',probs.length?'warn':'');
  }finally{_loadingAll=false;btn.disabled=false;}
}

