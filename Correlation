  '6M':'6M','6MO':'6M','9M':'9M','9MO':'9M','1Y':'1Y','12M':'1Y','1YR':'1Y','18M':'18M','1.5Y':'18M','2Y':'2Y','24M':'2Y','2YR':'2Y'};
function normTenor(s){
  const k=String(s==null?'':s).toUpperCase().replace(/\s+/g,'')
    .replace(/^(\d+(?:\.\d+)?)(WEEKS?|WKS?|WK)$/,'$1W').replace(/^(\d+(?:\.\d+)?)(MONTHS?|MTHS?|MOS?|MO)$/,'$1M').replace(/^(\d+(?:\.\d+)?)(YEARS?|YRS?|YR)$/,'$1Y');
