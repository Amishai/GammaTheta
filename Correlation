    va = 7.5 * np.exp(np.concatenate([[0], np.cumsum(0.05 * z1)]))
    vb = 6.0 * np.exp(np.concatenate([[0], np.cumsum(0.05 * (0.6 * z1 + 0.8 * z2))]))
    r_, m_ = vol_vol_corr(va, vb, 252)
    exact = np.corrcoef(z1[-252:], 0.6 * z1[-252:] + 0.8 * z2[-252:])[0, 1]
    check('vol-vol corr = exact sample corr of vol shocks', abs(r_ - exact) < 1e-10,
          f'({r_:.4f} vs {exact:.4f} over {m_}d; population 0.60)')

    print('\n8b) Correlation mean reversion')
    hl = 0.5
