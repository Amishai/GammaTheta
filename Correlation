        nm = {'localhost', 'traderbox', 'traderbox.corp.example', '10.20.30.40', '127.0.0.1'}
        cp_, kp_ = os.path.join(td, 'c.pem'), os.path.join(td, 'k.pem')
        make_self_signed(cp_, kp_, nm)
        ctx_ = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        ctx_.load_cert_chain(cp_, kp_)
        fp = cert_fingerprint(cp_)
        check('self-signed certificate covers every name/IP and loads into TLS', nm <= cert_names(cp_) and len(fp) == 95, f'(SHA-256 {fp[:23]}…)')

    print(f"\n{sum(results)}/{len(results)} checks passed")
    return all(results)


# ######################################################################
#                                 MAIN
# ######################################################################
def main():
    global VIEWERS_CAN_PULL
    ap = argparse.ArgumentParser(description='Cross Vol Builder')
    ap.add_argument('--port', type=int, default=8090)
    ap.add_argument('--no-browser', action='store_true')
    ap.add_argument('--selftest', action='store_true', help='run the numerical checks and exit')
    ap.add_argument('--hash-password', nargs='?', const='cad', choices=['cad', 'app'],
                    help='print a new password entry: cad (CAD tab, default) or app (network sign-in)')
    ap.add_argument('--lan', action='store_true', help='serve on the network (HTTPS, sign-in for everyone but this machine)')
    ap.add_argument('--host', help='bind address (default 127.0.0.1; --lan = 0.0.0.0)')
    ap.add_argument('--cert', help='TLS certificate (PEM), e.g. one issued by your firm; default: self-signed')
    ap.add_argument('--key', help='TLS private key (PEM) for --cert')
    ap.add_argument('--allow-host', action='append', default=[], help='extra hostname/IP colleagues use to reach you (repeatable)')
    ap.add_argument('--viewers-can-pull', action='store_true', help='let signed-in viewers trigger Bloomberg pulls on your session')
    ap.add_argument('--insecure-http', action='store_true', help='allow --lan without HTTPS (passwords would cross the network in clear)')
    ap.add_argument('--refresh-mins', type=int, default=180, help='shared Bloomberg refresh interval in minutes, on a grid from midnight (180 = 06:00, 09:00, 12:00, 15:00, 18:00 in the default window; 0 = off)')
    ap.add_argument('--refresh-window', default='06:00-20:00', help='local hours the refresh runs, e.g. 07:00-18:00, or "all"')
    ap.add_argument('--refresh-weekends', action='store_true', help='also refresh on Saturday / Sunday')
    ap.add_argument('--universe', default=None,
                    help='pairs the shared site keeps loaded: default (16 legs + 30 main crosses; the --lan default), all (every '
                         'combination, 120 crosses: check your Bloomberg limits), used (only what people open; local default), '
                         'or a list like EURJPY,GBPJPY,AUDNZD')
    args = ap.parse_args()
    if args.hash_password:
        label = 'CAD-tab' if args.hash_password == 'cad' else 'network sign-in'
        pw = getpass.getpass(f'New {label} password: ')
        if pw != getpass.getpass('Repeat: '):
            raise SystemExit('Passwords differ')
        print(('CAD_TAB_PASSWORD' if args.hash_password == 'cad' else 'APP_PASSWORD') + ' = ' + repr(hash_password(pw)))
        return
    if args.selftest:
        raise SystemExit(0 if selftest() else 1)
    REFRESH['mins'] = max(0, args.refresh_mins)
    REFRESH['weekdays_only'] = not args.refresh_weekends
    if args.refresh_window.strip().lower() in ('all', '24h', ''):
        REFRESH['window'] = None
    else:
        try:
            w0, w1 = [int(x.split(':')[0]) * 60 + int(x.split(':')[1]) for x in args.refresh_window.split('-')]
            REFRESH['window'] = (w0, w1)
        except (ValueError, IndexError):
            raise SystemExit('--refresh-window must look like 06:00-20:00 (or "all")')
    bind = args.host or ('0.0.0.0' if args.lan else '127.0.0.1')
    uv = (args.universe or ('default' if (args.lan or args.host) else 'used')).strip()
    if uv.lower() in ('default', 'all', 'used'):
        UNIVERSE['mode'] = uv.lower()
    else:
        bad = [c for c in uv.split(',') if not cross_to_legs(c)]
        if bad:
            raise SystemExit(f'--universe: unknown cross(es) {bad} (each currency needs a USD leg in LEG_PAIRS)')
        UNIVERSE.update(mode='custom', crosses=[c.strip().upper() for c in uv.split(',')])
    SERVER['lan'] = not is_loopback(bind)
    VIEWERS_CAN_PULL = bool(args.viewers_can_pull)
    names = local_addresses() | {h.lower() for h in args.allow_host} if SERVER['lan'] else {'localhost', '127.0.0.1', '::1'}
    SERVER['allowed_hosts'] = names
    use_tls = bool(args.cert or SERVER['lan']) and not args.insecure_http
    if SERVER['lan'] and not use_tls:
        log('WARNING: --insecure-http: sign-in passwords and data cross the network unencrypted')
    srv = Server((bind, args.port), Handler)
    scheme = 'http'
    if use_tls:
        ctx, cert = tls_context(args.cert, args.key, names)
        srv.socket = ctx.wrap_socket(srv.socket, server_side=True, do_handshake_on_connect=False)   # handshake in the worker thread
        SERVER['tls'], scheme = True, 'https'
    url = f'{scheme}://localhost:{args.port}'
    log(f'Cross Vol Builder on {url}  (Bloomberg: {"available" if BB.available() else "offline — " + BB.last_error})')
    if SERVER['lan']:
        share = sorted(n for n in names if n not in ('localhost', '127.0.0.1', '::1') and ':' not in n)
        log('Shared on the network. Colleagues open (any of):')
        for n in share:
            log(f'    {scheme}://{n}:{args.port}')
        log('  They sign in with the network password; you (this machine) have full control at ' + url)
        log('  Viewers ' + ('CAN trigger Bloomberg pulls on your session (--viewers-can-pull)' if VIEWERS_CAN_PULL
                             else 'can use everything except Bloomberg pulls: they work from the shared data (your pulls + the scheduled refresh)'
                             + ('' if BB.available() else '; Bloomberg is offline now, so everyone sees placeholders')))
        if use_tls and not args.cert:
            log('  Self-signed certificate: browsers will warn once. Tell colleagues to check this fingerprint')
            log('  (browser padlock -> certificate details) before clicking through:')
            log('    SHA-256 ' + cert_fingerprint(cert))
    if REFRESH['mins']:
        threading.Thread(target=refresh_scheduler, daemon=True).start()
        time.sleep(0.05)
        ri = refresh_info()
        log(f"Shared Bloomberg refresh every {REFRESH['mins']} min ({'all day' if ri['window'] is None else ri['window']}"
            f"{', weekdays' if REFRESH['weekdays_only'] else ''}); next {ri['next'] or 'none'}")
    if UNIVERSE['mode'] != 'used':
        nc = len(universe_combos()) - len(LEG_PAIRS)
        if BB.available():
            log(f'Shared universe: {len(LEG_PAIRS)} legs + {nc} crosses ({UNIVERSE["mode"]}). Loading it in the background now; '
                'colleagues can start straight away, pairs fill in as they load.')
            threading.Thread(target=refresh_shared, args=('startup',), daemon=True).start()
        else:
            log(f'Shared universe ({UNIVERSE["mode"]}, {nc} crosses) loads when Bloomberg is connected.')
    if not args.no_browser:
        threading.Timer(0.8, lambda: webbrowser.open(url)).start()
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        log('shutting down')


if __name__ == '__main__':
    main()
