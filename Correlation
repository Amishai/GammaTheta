function parseBumps(txt){const v=String(txt||'').split(/[\s,;]+/).map(parseCell).filter(x=>x!=null&&!Number.isNaN(x));return [...new Set(v.concat([0]))].sort((a,b)=>a-b);}
function ladderRun(bk,which,bumps){const out=[];bumps.forEach(b=>{let sa=bk.sa0,sb=bk.sb0,rq=bk.rq0;
  if(which==='rho'){rq+=b;if(!(rq>-0.999&&rq<0.999))return;}else if(which==='A')sa+=b/100;else sb+=b/100;
  if(sa<=0||sb<=0)return;const n=ladderNode(bk,sa,sb,rq);n.bump=b;out.push(n);});return out;}
