def hash_password(pw, iterations=390000):
    salt = secrets.token_hex(16)
    return {'algo': 'pbkdf2_sha256', 'iter': iterations, 'salt': salt,
            'hash': hashlib.pbkdf2_hmac('sha256', pw.encode(), bytes.fromhex(salt), iterations).hex()}


def check_password(pw, entry=None):
    h = entry or CAD_TAB_PASSWORD
    dk = hashlib.pbkdf2_hmac('sha256', str(pw).encode(), bytes.fromhex(h['salt']), int(h['iter'])).hex()
    return hmac.compare_digest(dk, h['hash'])


class PasswordGate:
    """Server-side password check -> random session token in an HttpOnly cookie.
    5 wrong tries from one IP address lock that address out for 60s (other addresses unaffected)."""

    def __init__(self, cookie, hours, entry):
        self.cookie, self.hours, self.entry = cookie, hours, entry
        self.sessions, self.fails, self.lock = {}, {}, threading.Lock()

    def login(self, pw, ip='?'):
        with self.lock:
            f = self.fails.setdefault(ip, {'n': 0, 'until': 0.0})
            now = time.time()
            if now < f['until']:
                return 429, f'Too many attempts — try again in {int(f["until"] - now) + 1}s'
        ok = check_password(pw, self.entry())                 # slow on purpose (PBKDF2); outside the lock
        with self.lock:
            f = self.fails.setdefault(ip, {'n': 0, 'until': 0.0})
            if not ok:
                f['n'] += 1
                if f['n'] >= 5:
                    f.update(n=0, until=time.time() + 60)
                    return 429, 'Too many attempts — locked for 60s'
                return 401, 'Wrong password'
            f['n'] = 0
            tok = secrets.token_urlsafe(32)
            self.sessions[tok] = time.time() + self.hours * 3600
            for k in [k for k, v in self.sessions.items() if v < time.time()]:
                self.sessions.pop(k, None)
            return 200, tok

    def check(self, cookie_header):
        tok = None
        for part in (cookie_header or '').split(';'):
            k, _, v = part.strip().partition('=')
            if k == self.cookie:
                tok = v
        with self.lock:
            exp = self.sessions.get(tok) if tok else None
            if exp and exp > time.time():
                return tok
            if tok:
                self.sessions.pop(tok, None)
        return None

    def logout(self, tok):
        with self.lock:
            self.sessions.pop(tok, None)


CAD_GATE = PasswordGate('cv_cad', CAD_SESSION_HOURS, lambda: CAD_TAB_PASSWORD)
