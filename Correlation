function legEdits(L){                        // cells the user changed vs the last pull: [[tenor,key,value]]
  const out=[];if(!L||!L._orig)return out;
  TENORS.forEach(t=>{const r=L.rows[t]||{},o=L._orig[t]||{};GRID_KEYS.forEach(k=>{const v=r[k],w=o[k];
    const same=(v==null&&w==null)||(v!=null&&w!=null&&Math.abs(v-w)<1e-12);if(!same)out.push([t,k,v]);});});
  return out;
}
function askEdits(n){                         // inline prompt; resolves 'keep' | 'discard' | 'cancel'
  return new Promise(res=>{const el=$('banner');
    el.innerHTML='<span>You have <b>'+n+'</b> edited cell'+(n>1?'s':'')+' in the leg grids. A refresh replaces them with Bloomberg.</span>'
      +'<button class="act primary" data-a="keep">Refresh, keep my edits</button><button class="act" data-a="discard">Refresh, discard edits</button><button class="act" data-a="cancel">Cancel</button>';
    el.style.display='flex';
    el.querySelectorAll('button').forEach(b=>b.onclick=()=>{el.style.display='none';el.innerHTML='';res(b.dataset.a);});});
}
async function refreshMarket(opts){          // legs (fresh Bloomberg pull) + market cross quotes (implied rho)
  opts=opts||{};
  const ed={A:legEdits(S.legs.A),B:legEdits(S.legs.B)},n=ed.A.length+ed.B.length;
  let choice=opts.choice||'discard';
  if(n&&!opts.choice){choice=await askEdits(n);if(choice==='cancel'){status('Refresh cancelled');return 'cancel';}}
  status('Refreshing Bloomberg legs and '+crossNm()+' quotes…');
  const pull=async w=>{const pair=w==='A'?S.pairA:S.pairB;
    try{const L=await api('/api/surface?pair='+pair);L._orig=JSON.parse(JSON.stringify(L.rows));
      if(choice==='keep')ed[w].forEach(([t,k,v])=>{L.rows[t]=L.rows[t]||{};L.rows[t][k]=v;});
      S.legs[w]=L;return null;}catch(e){return pair+': '+e.message;}};
  const errs=(await Promise.all([pull('A'),pull('B')])).filter(Boolean);
  try{S.mkt=await api('/api/cross_market?a='+S.pairA+'&b='+S.pairB);}catch(e){errs.push('cross quotes: '+e.message);}
  S.asof=new Date();if(S.tri)S.tri.cur=null;      // new marks: the triangle scenario restarts from them
  renderLeg('A');renderLeg('B');renderCorr();save();updateAsof();
  status(errs.length?'Refresh finished with errors: '+errs.join('; '):'Refreshed '+S.pairA+', '+S.pairB+' and '+crossNm()+' quotes'
    +(n?(choice==='keep'?' · kept your '+n+' edit'+(n>1?'s':''):' · discarded '+n+' edit'+(n>1?'s':'')):'')
    +' · implied ρ updated',errs.length?'err':'');
  return !errs.length;
}
