          H['source'] in ('SYNTHETIC', 'BBG') and -0.12 < stH['premium']['mean'] < 0.0 and stH['backtest_long']['hit'] > 50,
          f"(mean prem {stH['premium']['mean']:+.3f}, long rho hit {stH['backtest_long']['hit']:.0f}% over {stH['backtest_entries']} trades)")
