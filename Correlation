def _cad_build_worker(args):
    """Runs in a worker process: one cross surface."""
    legA, legB, rho, rs, sr, hl = args
    try:
        return build_surface(legA, legB, rho, rho_sig_by_tenor=rs, sig_rho_by_tenor=sr, rho_half_life=hl)
    except Exception as e:
        return {'fatal': f'{type(e).__name__}: {e}'}


class CadBoard:
    def __init__(self):
        self.lock = threading.Lock()
        self.snapshot = None           # latest board (any rho source)
        self.snaps = {}                # rho source -> board
        self.building = False
        self.progress = {'done': 0, 'total': len(CAD_CROSSES), 'stage': ''}
        self.error = ''
        self._corr_cache = {}          # (a, b, date) -> get_corr payload (history-based, refreshed daily)
        self._pool = None

    def status(self):
        with self.lock:
            return {'building': self.building, 'progress': dict(self.progress), 'error': self.error,
                    'asof': self.snapshot['asof'] if self.snapshot else None,
                    'asof_by_src': {k: v['asof'] for k, v in self.snaps.items()}}

    def start(self, rho_src='implied', mode='live', wait=False):
        """Build the board for one or more rho sources in `mode` (live / store). wait=True blocks
        (used by the shared refresh, which first waits for any build in progress)."""
        srcs = [rho_src] if isinstance(rho_src, str) else list(rho_src)
        t_end = time.time() + 300
        while True:
            with self.lock:
                if not self.building:
                    self.building, self.error = True, ''
                    self.progress = {'done': 0, 'total': len(CAD_CROSSES) * len(srcs), 'stage': 'pulling market data'}
                    break
            if not wait or time.time() > t_end:
                return False
            time.sleep(0.5)

        def go():
            try:
                for src in srcs:
                    with data_mode_ctx(mode):
                        self._run(src)
            finally:
                with self.lock:
                    self.building = False
                    self.progress['stage'] = 'done'
        if wait:
            go()
        else:
            threading.Thread(target=go, daemon=True).start()
        return True

    def built_sources(self):
        with self.lock:
            return set(self.snaps)

    def _corr(self, a, b):
        key = (a, b, date.today())
        if key not in self._corr_cache:
            self._corr_cache[key] = get_corr(a, b)
        return self._corr_cache[key]

    def _pool_map(self, jobs):
        try:
            if self._pool is None:
                self._pool = shared_pool()
            futs = [self._pool.submit(_cad_build_worker, j) for j in jobs]
            out = []
            for f in futs:
                out.append(f.result())
                with self.lock:
                    self.progress['done'] += 1
            return out
        except Exception as e:                                 # no process pool available: build serially
            log(f'process pool unavailable ({e}); building serially')
            self._pool = _POOL['ex'] = None
            out = []
            for j in jobs:
                out.append(_cad_build_worker(j))
                with self.lock:
                    self.progress['done'] += 1
            return out

    def _run(self, rho_src):
        t0 = time.time()
        try:
            legs = {}
            for p in sorted({p for ab in CAD_CROSSES for p in ab}):
                legs[p] = get_surface(p)
            prep = []
            for a, b in CAD_CROSSES:
                La, Lb = legs[a], legs[b]
                M = get_cross_market(a, b)
                C = self._corr(a, b)
                sA, sB = leg_info(a)[1], leg_info(b)[1]
                sg = sA * sB
                imp_q, real_q, used_q = {}, {}, {}
                for t in TENORS:
                    ra, rb, mx = La['rows'].get(t), Lb['rows'].get(t), (M.get('rows') or {}).get(t)
                    iq = None
                    if ra and rb and mx and mx.get('atm'):
                        v = sg * implied_rho_y(ra['atm'], rb['atm'], mx['atm'])
                        iq = v if -1 < v < 1 else None
                    rq = (C['by_tenor'].get(t) or {}).get('rho_quoted')
                    imp_q[t], real_q[t] = iq, rq
                    u = iq if (rho_src == 'implied' and iq is not None) else rq
                    if u is not None:
                        used_q[t] = u
                rs = {t: v['rho_sig'] for t, v in C.get('vol_vol', {}).items() if v.get('rho_sig') is not None}
                cv = C.get('corr_vol') or {}
                sr = {t: cv.get('value') for t in TENORS if cv.get('value') is not None}
                hl = cv.get('half_life') or DEFAULT_RHO_HALF_LIFE
                prep.append({'a': a, 'b': b, 'La': La, 'Lb': Lb, 'M': M, 'C': C, 'sg': sg,
                             'imp': imp_q, 'real': real_q, 'used': used_q, 'job': (La, Lb, used_q, rs, sr, hl)})
            with self.lock:
                self.progress['stage'] = 'building surfaces'
            built = self._pool_map([p['job'] for p in prep])
            crosses = [self._summarise(p, s, rho_src) for p, s in zip(prep, built)]
            snap = {'asof': datetime.now().strftime('%Y-%m-%d %H:%M:%S'), 'secs': round(time.time() - t0, 1),
                    'rho_src': rho_src, 'crosses': crosses, 'tenors': TENORS,
                    'sources': sorted({legs[p]['source'] for p in legs}), 'data_version': STORE.version}
            with self.lock:
                self.snapshot = snap
                self.snaps[rho_src] = snap
        except NotInStore as e:
            with STORE.lock:
                STORE.wanted_cad = True
            with self.lock:
                self.error = (f'The CAD board\'s data isn\'t in the shared data yet. Queued for the next refresh '
                              f'({REFRESH["next"] or "when the host refreshes"}).')
        except Exception as e:
            log(traceback.format_exc())
            with self.lock:
                self.error = f'{type(e).__name__}: {e}'

    @staticmethod
    def _summarise(p, s, rho_src):
        a, b, La, Lb, M, sg = p['a'], p['b'], p['La'], p['Lb'], p['M'], p['sg']
        base, quote = cross_ccys(a, b)
        cad_leg = a if 'CAD' in a else b
        other = b if cad_leg == a else a
        if 'fatal' in s:
            return {'cross': base + quote, 'legs': [a, b], 'other_leg': other, 'cad_leg': cad_leg, 'error': s['fatal'], 'rows': []}
        Y = {leg_info(a)[0]: La['spot'] if leg_info(a)[1] > 0 else 1 / La['spot'],
             leg_info(b)[0]: Lb['spot'] if leg_info(b)[1] > 0 else 1 / Lb['spot']}
        SX = Y[base] / Y[quote]
        pts = lambda x: None if x is None or not math.isfinite(x) else round(x * 100, 4)
        rows = []
        by_t = {r['tenor']: r for r in s['tenors']}
        for t in TENORS:
            r = by_t.get(t)
            mk = (M.get('rows') or {}).get(t) or {}
            if not r:
                rows.append({'tenor': t, 'error': s['errors'].get(t, 'no inputs')})
                continue
            sa_, sb_ = La['rows'][t]['atm'] / 100, Lb['rows'][t]['atm'] / 100
            ry = sg * r['rho_quoted']
            sx = triangle_cross(sa_, sb_, ry)
            d_a, d_b = (sa_ - ry * sb_) / sx, (sb_ - ry * sa_) / sx
            d_other, d_cad = (d_b, d_a) if cad_leg == a else (d_a, d_b)
            d_rhoY01 = -sa_ * sb_ / sx * 0.01 * 100              # vol pts of cross per +0.01 rho_Y
            T = TENOR_YEARS[t]
            v = r['res']
            rows.append({'tenor': t, 'rho_y_impl': None if p['imp'][t] is None else sg * p['imp'][t],
                         'rho_y_real': None if p['real'][t] is None else sg * p['real'][t], 'rho_y_used': ry,
                         'atm': pts(v['atm']), 'rr25': pts(v['rr25']), 'rr10': pts(v['rr10']),
                         'bf25': pts(v['bf25b']), 'bf10': pts(v['bf10b']),
                         'mkt': {k: mk.get(k) for k in ('atm', 'rr25', 'rr10', 'bf25', 'bf10')},
                         'sig_other': (Lb if other == b else La)['rows'][t]['atm'], 'sig_cad': (La if cad_leg == a else Lb)['rows'][t]['atm'],
                         'd_other': d_other, 'd_cad': d_cad, 'd_rho01': d_rhoY01,
                         'vega_unit': atm_vega_usd(SX, sx, T, Y[quote]) * 0.01,     # USD per vol pt per 1 unit base notional
                         'flags': list(r['notes'])})
        return {'cross': base + quote, 'legs': [a, b], 'other_leg': other, 'cad_leg': cad_leg, 'spot': SX,
                'base': base, 'quote': quote, 'sources': [La['source'], Lb['source'], M.get('source')],
                'rows': rows, 'errors': s['errors']}


