function splitClip(text){
  let lines=String(text).replace(/\r\n?/g,'\n').split('\n');
  while(lines.length&&lines[lines.length-1].trim()==='')lines.pop();
  const tabbed=lines.some(l=>l.includes('\t'));
  return lines.map(l=>tabbed?l.split('\t'):(l.trim()===''?['']:l.trim().split(/\s{2,}|\s*;\s*|\s+/)));
}
// plan where a pasted block goes: {cells:[[r,c,raw]], mode, info}
function planPaste(text,r0,c0,nRows,nCols){
  const M=splitClip(text);if(!M.length)return {cells:[],mode:'empty',info:''};
  let body=M,colMap=null,mode='positional';
  const first=M[0],isNum=v=>{const p=parseCell(v);return p!==null&&!Number.isNaN(p);};
  // a header row has text and no numbers (a data row with one bad cell is still data)
  const isHeader=!first.some(isNum)&&first.some(v=>String(v).trim()!=='')&&!normTenor(first[0]);
  const hk=first.map(headerKey);
  if(isHeader&&hk.some(k=>k&&k!=='__tenor')){colMap=hk;body=M.slice(1);mode='header';}
  else if(isHeader){body=M.slice(1);mode='positional (header row ignored)';}
  const tenorCol=colMap?colMap.indexOf('__tenor'):-1;
  let tc=tenorCol>=0?tenorCol:-1;
  if(tc<0&&body.length){const hits=body.filter(r=>normTenor(r[0])).length;if(hits>=Math.max(1,Math.ceil(body.length/2)))tc=0;}
  const cells=[];let skipped=0,outside=0;
  body.forEach((row,i)=>{
    let r;
    if(tc>=0){const tn=normTenor(row[tc]);if(!tn){skipped++;return;}r=TENORS.indexOf(tn);}
    else r=r0+i;
    if(r<0||r>=nRows){outside++;return;}
    let ci=0;
    row.forEach((raw,j)=>{
      if(j===tc)return;
      let c;
      if(colMap){const key=colMap[j];if(!key||key==='__tenor')return;c=GRID_KEYS.indexOf(key);}
      else{c=c0+ci;ci++;}
      if(c<0||c>=nCols){outside++;return;}
      cells.push([r,c,raw]);
    });
  });
  if(tc>=0)mode+=' + tenor labels';
  return {cells,mode,skipped,outside};
}
function legGrid(which){
