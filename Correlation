_CLIENT_GONE = (BrokenPipeError, ConnectionResetError, ConnectionAbortedError, ssl.SSLError, socket.timeout)


class Handler(BaseHTTPRequestHandler):
    timeout = 60                                    # idle connections can't hold a thread forever
    server_version = 'CrossVol'
    sys_version = ''

    def log_message(self, *a):
        pass

    # ---- who is asking ----
    def _ip(self):
        return self.client_address[0]

    def _role(self):
        """'host' for requests from this machine, 'viewer' for a logged-in network user, else None."""
        if is_loopback(self._ip()):
            return 'host'
        return 'viewer' if APP_GATE.check(self.headers.get('Cookie')) else None

    def _host_ok(self):
        """Reject requests addressed to a name this server doesn't own (blocks DNS-rebinding pages
        from driving the tool through a colleague's or your own browser)."""
        return host_of(self.headers.get('Host')) in SERVER['allowed_hosts']

    def _cookie(self, name, val, max_age):
        return (f'{name}={val}; HttpOnly; SameSite=Strict; Path=/; Max-Age={max_age}'
                + ('; Secure' if SERVER['tls'] else ''))

    def _send(self, code, payload, ctype='application/json', headers=None):
        data = payload if isinstance(payload, bytes) else json.dumps(payload, default=_jsonable).encode()
        self.send_response(code)
        self.send_header('Content-Type', ctype)
        self.send_header('Cache-Control', 'no-store')
        self.send_header('X-Content-Type-Options', 'nosniff')
        self.send_header('X-Frame-Options', 'DENY')
        self.send_header('Referrer-Policy', 'no-referrer')
        if SERVER['tls']:
            self.send_header('Strict-Transport-Security', 'max-age=86400')
        for k, v in (headers or {}).items():
            self.send_header(k, v)
        self.send_header('Content-Length', str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def _data(self, name, fn, *args):
        role, pref = self._role(), self.headers.get('X-CV-Source') == 'store'
        code, out = serve_data(role, name, fn, *args, prefer_store=pref)
        self._send(code, out, headers={'X-Data-Version': str(STORE.version)} if (role == 'host' and not pref) else None)

    def _build(self, fn, body):
        # builds are pure functions of their inputs: identical requests (same marks, same rho) share one result
        key = (fn.__name__, hashlib.sha1(json.dumps(body, sort_keys=True, default=str).encode()).hexdigest())
        with _RESULT_LOCK:
            if key in _BUILDS:
                _BUILDS.move_to_end(key)
                return _BUILDS[key]
        res = self._build_run(fn, body)
        if res is not None:
            with _RESULT_LOCK:
                _BUILDS[key] = res
                while len(_BUILDS) > 120:
                    _BUILDS.popitem(last=False)
        return res

    def _build_run(self, fn, body):
        if not BUILD_SLOTS.acquire(timeout=90):
            self._send(503, {'error': 'server busy building other surfaces — try again in a moment'})
            return
        try:
            return fn(body)
        finally:
            BUILD_SLOTS.release()

    def do_GET(self):
        u = urlparse(self.path)
        q = {k: v[0] for k, v in parse_qs(u.query).items()}
        try:
            if not self._host_ok():
                self._send(403, {'error': 'host not allowed (start with --allow-host NAME to add one)'})
                return
            role = self._role()
            if role is None:                         # network user without a session: login page only
                if u.path in ('/', '/index.html', '/login'):
                    self._send(200, LOGIN_HTML.encode(), 'text/html; charset=utf-8')
                else:
                    self._send(401, {'error': 'login required'})
                return
            if u.path in ('/', '/index.html'):
                self._send(200, HTML.encode(), 'text/html; charset=utf-8')
            elif u.path == '/api/status':
                self._send(200, {'bbg': BB.available(), 'error': BB.last_error if role == 'host' else '', 'pairs': LEG_PAIRS,
                                 'tenors': TENORS, 'windows': CORR_WINDOW_BDAYS, 'role': role, 'lan': SERVER['lan'],
                                 'tls': SERVER['tls'], 'viewers_pull': viewer_may_pull(),
                                 'shared': {**STORE.stats(), 'refresh': refresh_info()}})
            elif u.path == '/api/surface':
                self._data('surface', get_surface, q['pair'].upper())
            elif u.path == '/api/corr':
                self._data('corr', get_corr, q['a'].upper(), q['b'].upper())
            elif u.path == '/api/cross_market':
                self._data('cross_market', get_cross_market, q['a'].upper(), q['b'].upper())
            elif u.path == '/api/corr_ci':
                self._data('corr_ci', get_corr_ci, q['a'].upper(), q['b'].upper(), float(q.get('years', CI_HISTORY_YEARS)))
            elif u.path == '/api/corr_monitor':
                self._data('corr_monitor', get_corr_monitor, q['a'].upper(), q['b'].upper(), q.get('tenor', '1M'),
                           int(q.get('window', 21)), int(q.get('ma', 5)), float(q.get('years', 1)))
            elif u.path == '/api/corr_history':
                self._data('corr_history', get_corr_history, q['a'].upper(), q['b'].upper(), q.get('tenor', '3M'), float(q.get('years', 3)))
            elif u.path == '/api/cad/status':
                tok = CAD_GATE.check(self.headers.get('Cookie'))
                self._send(200, {'authed': bool(tok), 'view_only': not (role == 'host' or viewer_may_pull()),
                                 **(CAD_BOARD.status() if tok else {})})
            elif u.path == '/api/cad/snapshot':
                if not CAD_GATE.check(self.headers.get('Cookie')):
                    self._send(401, {'error': 'locked'})
                else:
                    with CAD_BOARD.lock:
                        src = q.get('rho_src')
                        snap = CAD_BOARD.snaps.get(src) if src else CAD_BOARD.snapshot
                    self._send(200, {'snapshot': snap, **CAD_BOARD.status()})
            else:
                self._send(404, {'error': 'not found'})
        except _CLIENT_GONE:
            return                                   # the browser went away mid-response (closed tab, reload)
        except Exception as e:
            log(traceback.format_exc())
            try:
                self._send(500, {'error': f'{type(e).__name__}: {e}'})
            except _CLIENT_GONE:
                pass

    def do_POST(self):
        try:
            if not self._host_ok():
                self._send(403, {'error': 'host not allowed'})
                return
            n = int(self.headers.get('Content-Length', 0))
            if n > 8_000_000:
                self._send(413, {'error': 'request too large'})
                return
            body = json.loads(self.rfile.read(n) or b'{}')
            path = urlparse(self.path).path
            if path == '/api/login':
                code, val = APP_GATE.login(body.get('password', ''), self._ip())
                if code == 200:
                    log(f'viewer signed in from {self._ip()}')
                    self._send(200, {'ok': True}, headers={'Set-Cookie': self._cookie('cv_app', val, APP_SESSION_HOURS * 3600)})
                else:
                    self._send(code, {'error': val})
                return
            role = self._role()
            if role is None:
                self._send(401, {'error': 'login required'})
                return
            if path == '/api/app_logout':
                tok = APP_GATE.check(self.headers.get('Cookie'))
                if tok:
                    APP_GATE.logout(tok)
                self._send(200, {'ok': True}, headers={'Set-Cookie': self._cookie('cv_app', '', 0)})
                return
            if path == '/api/auth':
                code, val = CAD_GATE.login(body.get('password', ''), self._ip())
                if code == 200:
                    self._send(200, {'ok': True}, headers={'Set-Cookie': self._cookie('cv_cad', val, CAD_SESSION_HOURS * 3600)})
                else:
                    self._send(code, {'error': val})
                return
            if path == '/api/logout':
                tok = CAD_GATE.check(self.headers.get('Cookie'))
                if tok:
                    CAD_GATE.logout(tok)
                self._send(200, {'ok': True}, headers={'Set-Cookie': self._cookie('cv_cad', '', 0)})
                return
            if path == '/api/cad/refresh':
                if not CAD_GATE.check(self.headers.get('Cookie')):
                    self._send(401, {'error': 'locked'})
                    return
                src = body.get('rho_src', 'implied') if body.get('rho_src') in ('implied', 'realized') else 'implied'
                mode = 'live' if (role == 'host' or viewer_may_pull()) else 'store'
                if mode == 'store':                          # viewers rebuild from the shared data, never Bloomberg
                    with CAD_BOARD.lock:
                        snap = CAD_BOARD.snaps.get(src)
                    if snap and snap.get('data_version') == STORE.version:
                        self._send(200, {'started': False, 'current': True, **CAD_BOARD.status()})
                        return
                started = CAD_BOARD.start(src, mode=mode)
                self._send(200, {'started': started, **CAD_BOARD.status()})
                return
            if path == '/api/refresh_shared':
                if role != 'host':
                    self._send(403, {'error': 'only the host can refresh the shared data'})
                    return
                threading.Thread(target=refresh_shared, args=('manual',), daemon=True).start()
                self._send(200, {'started': True})
                return
            if path == '/api/build_band':
                res = self._build(run_build_band, body)
                if res is not None:
                    self._send(200, res)
                return
            if path == '/api/build':
                res = self._build(run_build, body)
                if res is None:
                    return
                log(f"built {res['cross']} {len(res['rows'])} tenors in {res['secs']}s" + ('' if role == 'host' else f' for {self._ip()}')
                    + (f" errors={res['errors']}" if res['errors'] else ''))
                self._send(200, res)
            else:
                self._send(404, {'error': 'not found'})
        except _CLIENT_GONE:
            return                                   # the browser went away mid-response (closed tab, reload)
        except Exception as e:
            log(traceback.format_exc())
            try:
                self._send(500, {'error': f'{type(e).__name__}: {e}'})
            except _CLIENT_GONE:
                pass


def _jsonable(o):
    if isinstance(o, np.floating):
        return float(o)
    if isinstance(o, np.integer):
        return int(o)
    if isinstance(o, (date, datetime)):
        return o.isoformat()
    raise TypeError(type(o))


