  const focus=(r,c,extend)=>{r=Math.max(0,Math.min(nR-1,r));c=Math.max(0,Math.min(nC-1,c));
    if(extend){G.sel.r1=r;G.sel.c1=c;}else{G.sel={r0:r,c0:c,r1:r,c1:c};}
    G.act={r,c};G.inEdit=false;const el=cell(r,c);G.noSel=!!extend;el.focus();if(!extend)el.select();paint();};
  const commit=(el)=>{const r=+el.dataset.r,c=+el.dataset.c,v=parseCell(el.value);
    if(Number.isNaN(v)){el.value=show(get(r,c));status('Not a number: "'+el.value+'"','err');return;}
    const old=get(r,c);if(old===v||(old!=null&&v!=null&&Math.abs(old-v)<1e-12))return;
    snap();set(r,c,v);save();paint();renderTri();};
  const done=(msg,cls)=>{save();paint(true);if(msg)status(msg,cls);renderTri();};
  G.api={paste(text){                               // used by the paste handler and the tests
