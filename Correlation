  const ry=bk.sg*rq,sx=triX(sa,sb,ry),sig={X:sx,A:sa,B:sb},nd={};let pnl=0;
  Object.entries(bk.inst).forEach(([k,d])=>{const o=atmOptJ(d.S,d.K,sig[k],bk.T);pnl+=d.N*(o.v-d.v0)*d.upq;
    nd[k]={vega:d.N*o.vega*d.upq*0.01,g1:d.N*o.cgamma*d.upq*0.01,cg:d.N*o.cgamma*d.upq,delta:d.N*(o.delta-d.hedge)};});
  const dA=(sa-ry*sb)/sx,dB=(sb-ry*sa)/sx,dRq=bk.sg*(-sa*sb/sx),vX=nd.X.vega;
  const dd={};dd[bk.base]=0;dd[bk.quote]=0;
  dd[bk.base]+=nd.X.delta*bk.Y[bk.base];dd[bk.quote]-=nd.X.delta*bk.Y[bk.base];
  ['A','B'].forEach(k=>{const p=bk.pairs[k],ccy=legCcy(p);if(p.slice(3)==='USD')dd[ccy]+=nd[k].delta*bk.Y[ccy];else dd[ccy]-=nd[k].delta;});
  const kA=bk.legCcy.A===bk.base?'A':'B',kB=kA==='A'?'B':'A',GX=nd.X.cg;
  return {sa,sb,rq,sx,pnl,inst:nd,deph:{vega_A:nd.A.vega+vX*dA,vega_B:nd.B.vega+vX*dB,vega_rho:vX*dRq,
    delta_base:dd[bk.base],delta_quote:dd[bk.quote],g_base:(GX+nd[kA].cg)*0.01,g_quote:(GX+nd[kB].cg)*0.01,g_cross:-GX*0.01}};
