        return done('Filled '+((b.r1-b.r0+1)*(b.c1-b.c0+1))+' cells with '+v);}
      snap();let n=0,bad=0;let rMin=nR,rMax=-1,cMin=nC,cMax=-1;
      p.cells.forEach(([r,c,raw])=>{const v=parseCell(raw);if(v===null)return;if(Number.isNaN(v)){bad++;return;}
