function baseLayout(ytitle){return {paper_bgcolor:css('--surface-1'),plot_bgcolor:css('--surface-1'),margin:{l:48,r:56,t:8,b:36},
  font:{color:css('--text-secondary'),size:11},hovermode:'x unified',showlegend:true,legend:{orientation:'h',y:-0.18,x:0},
  xaxis:{gridcolor:css('--grid'),zeroline:false,linecolor:css('--border')},yaxis:{title:{text:ytitle},gridcolor:css('--grid'),zerolinecolor:css('--border'),linecolor:css('--border')},
  hoverlabel:{bgcolor:css('--surface-2'),bordercolor:css('--border'),font:{color:css('--text-primary')}}};}
const CFG={displaylogo:false,responsive:true,modeBarButtonsToRemove:['lasso2d','select2d']};
function clip(c,lo,hi){const K=[],V=[];c.K.forEach((k,i)=>{if(k>=lo&&k<=hi&&c.vol[i]!==null){K.push(k);V.push(c.vol[i]);}});return {K,V};}
function drawSmile(){
  if(typeof Plotly==='undefined'){$('chSmile').innerHTML='<div class="empty">Plotly failed to load (offline?)</div>';return;}
  const R=S.result,r=R.rows.find(x=>x.tenor===S.selTenor);if(!r)return;
  const labs=['10P','25P','ATM','25C','10C'];
  const kp=labs.map(l=>r.pillars[l][0]),pad=0.45*(kp[4]-kp[0]),lo=kp[0]-pad,hi=kp[4]+pad;
  const main=R.wings==='vov'?clip(r.curve,lo,hi):clip(r.curve_cop,lo,hi),alt=R.wings==='vov'?clip(r.curve_cop,lo,hi):clip(r.curve,lo,hi);
  const nMain=R.wings==='vov'?'Vol-of-vol':'Copula',nAlt=R.wings==='vov'?'Gaussian copula':'Vol-of-vol';
  const tr=[{x:main.K,y:main.V,mode:'lines',name:nMain,line:{color:css('--s1'),width:2},hovertemplate:'K %{x:.5f}<br>%{y:.3f}<extra>'+nMain+'</extra>'},
    {x:alt.K,y:alt.V,mode:'lines',name:nAlt,line:{color:css('--s2'),width:2},hovertemplate:'K %{x:.5f}<br>%{y:.3f}<extra>'+nAlt+'</extra>'},
    {x:kp,y:labs.map(l=>r.pillars[l][1]),mode:'markers+text',text:labs,textposition:'top center',cliponaxis:false,textfont:{color:css('--text-secondary'),size:10},
     name:'Pillars',marker:{color:css('--s1'),size:9,line:{color:css('--surface-1'),width:2}},hovertemplate:'%{text} K %{x:.5f}<br>%{y:.3f}<extra></extra>'},
    {x:[lo,hi],y:[r.atm_formula,r.atm_formula],mode:'lines',name:'Formula ATM',line:{color:css('--ref'),width:1.5,dash:'dash'},hoverinfo:'skip'}];
  const L=baseLayout('vol');L.hovermode='closest';L.xaxis.title={text:'strike'};L.xaxis.range=[lo,hi];L.margin.r=20;
  Plotly.react('chSmile',tr,L,CFG);
}
function endLabel(x,y,name){return {x:[x[x.length-1]],y:[y[y.length-1]],mode:'text',text:[name],textposition:'middle right',cliponaxis:false,
  textfont:{color:css('--text-secondary'),size:10},showlegend:false,hoverinfo:'skip'};}
function drawTerms(){
  if(typeof Plotly==='undefined')return;
  const R=S.result,x=R.rows.map(r=>r.tenor);
  const nus=[['nu_a',R.leg_base,'--s2'],['nu_b',R.leg_quote,'--s3'],['nu_x',R.cross,'--s1']];
  const t1=[];nus.forEach(([k,n,c])=>{const y=R.rows.map(r=>r[k]);t1.push({x,y,mode:'lines+markers',name:n,line:{color:css(c),width:2},marker:{size:8},hovertemplate:'%{y:.3f}'});});
  const L1=baseLayout('ν (vol of vol)');L1.xaxis.type='category';L1.margin.r=20;Plotly.react('chNu',t1,L1,CFG);
  const ser=[['rr25','25 RR','--s1'],['rr10','10 RR','--s2'],['bf25b','25 BF','--s3'],['bf10b','10 BF','--s4']];
  const t2=[];ser.forEach(([k,n,c])=>{const y=R.rows.map(r=>r[k]);t2.push({x,y,mode:'lines+markers',name:n,line:{color:css(c),width:2},marker:{size:8},hovertemplate:'%{y:.3f}'});t2.push(endLabel(x,y,n));});
  const L2=baseLayout('vol pts');L2.xaxis.type='category';L2.yaxis.zerolinecolor=css('--text-muted');Plotly.react('chSkew',t2,L2,CFG);
}
function exportCsv(){
  const R=S.result;const cols=['tenor','F','atm','rr25','rr10','bf25b','bf10b','bf25s','bf10s','rho_quoted','rho_sig','sig_rho','sig_rho_eff','nu_a','nu_b','nu_x','atm_formula','atm_raw_copula','d_base_leg','d_quote_leg','d_rho10'];
  const lines=[cols.join(',')].concat(R.rows.map(r=>cols.map(c=>r[c]).join(',')));
  const blob=new Blob([lines.join('\n')],{type:'text/csv'});const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);a.download=R.cross+'_cross_surface_'+new Date().toISOString().slice(0,10)+'.csv';a.click();
}


