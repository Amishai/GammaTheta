  const el=$('cardAn'),A=S.an,c=crossNm();
  const ccy=c.slice(0,3),q=c.slice(3);
  let h='<h2>Correlation analytics — '+c+(S.hist?' <span class="badge '+(S.hist.source==='BBG'?'BBG':'PLACEHOLDER')+'">'+S.hist.source+'</span>':'')+'</h2>';
  h+='<div class="meta">Convention here: ρ = corr('+ccy+' vs USD, '+q+' vs USD), the ρ in σ('+c+')² = σA² + σB² − 2ρ·σA·σB. '
    +'<b style="color:var(--text-primary)">Long correlation = short '+c+' vol vs long leg vols (vega-neutral); wins if realized ρ ends above implied.</b></div>';
  h+='<div class="controls" style="margin-bottom:10px"><label class="f">Tenor<select id="anTenor">'+TENORS.map(t=>'<option'+(t===A.tenor?' selected':'')+'>'+t+'</option>').join('')+'</select></label>'
    +'<label class="f">Lookback<select id="anYears">'+[1,2,3,5].map(y=>'<option value="'+y+'"'+(y==A.years?' selected':'')+'>'+y+'Y</option>').join('')+'</select></label>'
    +'<label class="f">Cross vega (USD / vol pt)<input id="anVega" class="num wide" value="'+A.vega+'"></label>'
    +'<button class="act primary" id="btnHist">Load history</button></div>';
  h+='<div id="anBody">'+(S.hist?'':'<div class="empty">Load history to chart implied vs realized correlation, the premium and a hold-to-expiry backtest.</div>')+'</div>';
  el.innerHTML=h;
  $('anTenor').onchange=e=>{A.tenor=e.target.value;save();};
  $('anYears').onchange=e=>{A.years=+e.target.value;save();};
  $('anVega').onchange=e=>{A.vega=parseFloat(e.target.value)||0;save();if(S.hist)renderAnBody();};
  $('btnHist').onclick=loadHist;
  if(S.hist)renderAnBody();
}
async function loadHist(){
  $('anBody').innerHTML='<div class="empty">Loading '+S.an.tenor+' history…</div>';
  try{S.hist=await api('/api/corr_history?a='+S.pairA+'&b='+S.pairB+'&tenor='+S.an.tenor+'&years='+S.an.years);renderAnalytics();}
  catch(e){$('anBody').innerHTML='<div class="empty err">History failed: '+e.message+'</div>';}
