          f"(mean prem {st3['premium']['mean']:+.4f}, long hit {st3['backtest_long']['hit']:.0f}%, {st3['backtest_entries']} trades)")
    tc = trade_construction(100000, sa_, sb_, sx_, ry)
    pos = lambda A_, B_, r_: tc['cross_vega'] * variance_formula(A_ / 100, B_ / 100, r_)['atm'] * 100 \
