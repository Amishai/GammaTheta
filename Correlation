    # forward window alignment: forward[t] must use the n returns AFTER date t
    nd3 = 300
    pxa = 1.08 * np.exp(np.concatenate([[0], np.cumsum(0.005 * a3[:nd3 - 1])]))
    pxb = 1.37 * np.exp(-np.concatenate([[0], np.cumsum(0.004 * b3[:nd3 - 1])]))
    h3 = corr_history(list(range(nd3)), pxa, pxb, np.full(nd3, 7.5), np.full(nd3, 6.0), np.full(nd3, 7.19),
