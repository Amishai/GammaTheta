def _fine_curve(F, smile, ks, n=241):
    k = np.linspace(min(ks), max(ks), n)
    return {'K': [F * math.exp(x) for x in k], 'vol': [round(float(v) * 100, 4) for v in smile.vol_k(k)]}


def run_build(body):
    t0 = time.time()
    num = lambda d: {t: float(v) for t, v in (d or {}).items() if v is not None and v != ''}
    rho, rs, sr = num(body.get('rho')), num(body.get('rho_sig')), num(body.get('sig_rho'))
    legA, legB = body['legA'], body['legB']
    tenors = [t for t in TENORS if t in rho and t in legA['rows'] and t in legB['rows']]
    wings = body.get('wings', 'vov')
    s = build_surface(legA, legB, rho, usd_rate=float(body.get('usd_rate', 4.0)) / 100,
                      fly_conv=body.get('fly_conv', 'broker'), atm_anchor=body.get('atm_anchor', 'formula'),
                      delta_mode=body.get('delta_mode', 'auto'), tenors=tenors,
                      rho_sig_by_tenor=rs, sig_rho_by_tenor=sr, wings=wings,
                      rho_half_life=float(body.get('rho_half_life') or 0) or None)
    sA, sB = leg_info(s['leg_base'])[1], leg_info(s['leg_quote'])[1]
    pts = lambda x: None if x is None or not math.isfinite(x) else round(x * 100, 4)
    piv = lambda v: {k: pts(v[k]) for k in ('atm', 'rr25', 'rr10', 'bf25s', 'bf10s', 'bf25b', 'bf10b')}
    rows = []
    for r in s['tenors']:
        v, f, d = r['res'], r['formula'], r['diag']
        flags = list(r['notes'])
        if d['arb_leg_A'] or d['arb_leg_B']:
            flags.append(f"leg density <0 ({d['arb_leg_A']}/{d['arb_leg_B']} pts)")
        if d['arb_cross']:
            flags.append(f"copula convexity ({d['arb_cross']})")
        if abs(d['fwd_err']) > 1e-6:
            flags.append(f"fwd err {d['fwd_err']:.1e}")
        for sb in r['sabr_legs']:
            if sb['err'] > 0.002:
                flags.append(f"leg SABR fit err {sb['err'] * 100:.2f} vol")
        row = {'tenor': r['tenor'], 'T': r['tenor_T'], 'S': r['S'], 'F': r['F'], 'pa': r['pa'], 'dtype': r['dtype'],
               **piv(v), 'cop': piv(r['res_copula']), 'vov': piv(r['res_vov']),
               'atm_formula': pts(f['atm']), 'atm_raw_copula': pts(r['raw_copula_atm']),
               'rho_quoted': r['rho_quoted'], 'rho_copula': r['rho_copula'] * sA * sB,
               'rho_sig': r['rho_sig'], 'sig_rho': r['sig_rho_inst'], 'sig_rho_eff': r['sig_rho'],
               'nu_a': r['sabr_legs'][0]['nu'], 'nu_b': r['sabr_legs'][1]['nu'], 'nu_x': r['vov']['nu_x'],
               'w_a': r['vov']['w_a'], 'w_b': r['vov']['w_b'], 'var_parts': r['vov']['var_parts'],
               'sabr_legs': r['sabr_legs'], 'sabr_cross': r['sabr_cross'],
               'd_base_leg': f['d_sa'], 'd_quote_leg': f['d_sb'], 'd_rho10': f['d_rho_y'] * sA * sB * 0.10 * 100,
               'pillars': {k: [K, pts(vv)] for k, (K, vv) in v['pillars'].items()},
               'curve': _fine_curve(r['F'], r['smile_vov'], r['curve_k']),
               'curve_cop': _fine_curve(r['F'], r['smile_copula'], r['curve_k']),
               'legs': [{'pair': l['pair'], 'pa': l['pa'], 'dtype': l['dtype'],
                         'bf25_in': pts(l['bf25_in']), 'bf10_in': pts(l['bf10_in']),
                         'bs25': pts(l['bs25']), 'bs10': pts(l['bs10'])} for l in r['legs']],
               'flags': flags, 'secs': round(d['secs'], 2)}
        rows.append(row)
    return {'cross': s['cross'], 'leg_base': s['leg_base'], 'leg_quote': s['leg_quote'],
            'sign_note': s['sign_note'], 'rows': rows, 'errors': s['errors'],
            'calendar_flags': s['calendar_flags'], 'secs': round(time.time() - t0, 2),
            'atm_anchor': body.get('atm_anchor', 'formula'), 'fly_conv': body.get('fly_conv', 'broker'),
            'wings': wings}


_POOL = {'ex': None}


def shared_pool():
    """One process pool for parallel surface builds (confidence-band builds, CAD board)."""
    if _POOL['ex'] is None:
        from concurrent.futures import ProcessPoolExecutor
        _POOL['ex'] = ProcessPoolExecutor(max_workers=max(2, min(8, os.cpu_count() or 2)))
    return _POOL['ex']


def _band_worker(body):
    try:
        res = run_build(body)
        keep = ('tenor', 'atm', 'rr25', 'rr10', 'bf25b', 'bf10b', 'bf25s', 'bf10s', 'rho_quoted', 'curve')
        return {'rows': [{k: r[k] for k in keep} for r in res['rows']], 'errors': res['errors']}
    except Exception as e:
        return {'fatal': f'{type(e).__name__}: {e}'}


def run_build_band(body):
    """The same build at the band's low / centre / high rho (quoted, per tenor), in parallel."""
    t0 = time.time()
    bands = body.pop('rho_bands', {}) or {}
    names = [k for k in ('lo', 'mid', 'hi') if bands.get(k)]
    jobs = [dict(body, rho=bands[k]) for k in names]
    try:
        out = list(shared_pool().map(_band_worker, jobs))
    except Exception as e:                                     # no process pool here: serial
        log(f'process pool unavailable ({e}); band builds run serially')
        _POOL['ex'] = None
        out = [_band_worker(j) for j in jobs]
    return {'builds': dict(zip(names, out)), 'secs': round(time.time() - t0, 2)}


