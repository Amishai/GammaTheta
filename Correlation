function pctTxt(p){return p==null?'—':Math.round(p)+(Math.round(p)%10===1&&Math.round(p)!==11?'st':Math.round(p)%10===2&&Math.round(p)!==12?'nd':Math.round(p)%10===3&&Math.round(p)!==13?'rd':'th')+' pct';}
