  const a=+ra.atm,b=+rb.atm,x=+M.rows[t].atm;if(!(a>0&&b>0&&x>0))return null;
  return orient(S.legs.A.pair)*orient(S.legs.B.pair)*(a*a+b*b-x*x)/(2*a*b);}
