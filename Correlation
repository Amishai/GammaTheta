// ===================== Confidence band & outliers (mirrors get_corr_ci / cross_vol_band / cross_vol_pct) =====================
const CIQ={'0.68':0.9944578832097535,'0.8':1.2815515655446004,'0.9':1.6448536269514722,'0.95':1.959963984540054,'0.99':2.5758293035489004};   // = CI_LEVELS
const CI_LAB={'0.68':'68%','0.8':'80%','0.9':'90%','0.95':'95%','0.99':'99%'};
function ciCfg(){S.ci=S.ci||{};const d={level:'0.9',center:'realized',band:'fair',tenor:'3M'};for(const k in d)if(S.ci[k]===undefined)S.ci[k]=d[k];return S.ci;}   // in place: handlers keep a live reference
function ciKey(){return S.pairA+'|'+S.pairB;}
async function loadCI(force){const k=ciKey();if(!force&&S.ciData&&S.ciData._k===k&&!S.ciData.error)return S.ciData;
  try{const d=await api('/api/corr_ci?a='+S.pairA+'&b='+S.pairB);d._k=k;S.ciData=d;}catch(e){S.ciData={error:e.message,_k:k};}
  return S.ciData;}
function clampR(y){return Math.max(Math.min(y,0.999),-0.999);}
function ciRows(){
  const C=ciCfg(),D=S.ciData;if(!D||D.error||D._k!==ciKey()||!S.legs.A||!S.legs.B)return null;
  const sg=orient(S.legs.A.pair)*orient(S.legs.B.pair),q=CIQ[C.level],R=S.result&&S.result.cross===crossNm()?S.result:null;
  return TENORS.map(t=>{const d=D.by_tenor[t],ra=S.legs.A.rows[t],rb=S.legs.B.rows[t];
    if(!d||!ra||!rb||!(+ra.atm>0)||!(+rb.atm>0))return {tenor:t,skip:'no leg ATMs'};
    const cq=C.center==='used'?used('rho',t):realized('rho',t);if(cq==null||!isFinite(cq))return {tenor:t,skip:'no ρ for the centre'};
    const a=+ra.atm,b=+rb.atm,cy=sg*cq,sd=C.band==='fair'?d.sd_fair:d.sd_realized,z0=Math.atanh(clampR(cy));
    const ylo=Math.tanh(z0-q*sd),yhi=Math.tanh(z0+q*sd),tri=y=>Math.sqrt(Math.max(a*a+b*b-2*y*a*b,0));
    const r={tenor:t,a,b,sg,cq,cy,sd,z0,ylo,yhi,vlo:tri(yhi),vmid:tri(cy),vhi:tri(ylo),d};
    const rr=R&&R.rows.find(x=>x.tenor===t);r.model=rr?rr.atm:null;r.res=rr||null;
    const m=S.mkt&&S.mkt.rows&&S.mkt.rows[t];r.mq=m||{};r.mkt=m&&m.atm!=null&&isFinite(m.atm)?+m.atm:null;
    if(r.mkt!=null){const ym=(a*a+b*b-r.mkt*r.mkt)/(2*a*b);r.mkt_ry=ym;
      r.pct=ym<=-1?100:ym>=1?0:100*(1-ncdfJ((Math.atanh(ym)-z0)/sd));
      if(d.err&&d.err.length&&Math.abs(ym)<1){const zm=Math.atanh(ym);let k=0;d.err.forEach(e=>{if(z0+e>=zm)k++;});r.pct_hist=100*k/d.err.length;}
      r.out=r.mkt>r.vhi?'above':r.mkt<r.vlo?'below':'';}
    if(r.model!=null)r.model_pct=(()=>{const ym=(a*a+b*b-r.model*r.model)/(2*a*b);return Math.abs(ym)<1?100*(1-ncdfJ((Math.atanh(ym)-z0)/sd)):null;})();
    return r;});
}
// ---- wing bands: the same build at the band's rho edges (server, parallel) ----
function bandBody(rows){const B=S.lastBody;if(!B)return null;const lo={},mid={},hi={};
  rows.forEach(r=>{if(r.skip||!(r.tenor in (B.rho||{})))return;lo[r.tenor]=r.sg*r.yhi;mid[r.tenor]=r.cq;hi[r.tenor]=r.sg*r.ylo;});
  if(!Object.keys(mid).length)return null;return {...B,rho_bands:{lo,mid,hi}};}
let _bandTimer=null,_bandSeq=0;
function bandSig(body){return body?JSON.stringify([body.rho_bands,S.resultSig]):null;}
function scheduleBand(delay){clearTimeout(_bandTimer);_bandTimer=setTimeout(()=>{S._bandP=computeBand();},delay==null?350:delay);}
async function computeBand(){
  const rows=ciRows();if(!rows||!S.result)return;const body=bandBody(rows),sig=bandSig(body);if(!body)return;
