    ok_f = abs(h3['forward'][t3] - np.corrcoef(ra3[t3:t3 + 63], rb3[t3:t3 + 63])[0, 1]) < 1e-10
    ok_t = abs(h3['trailing'][t3] - np.corrcoef(ra3[t3 - 63:t3], rb3[t3 - 63:t3])[0, 1]) < 1e-10
    check('trailing uses the 63 returns before t, subsequent the 63 after', ok_f and ok_t
          and np.all(np.isnan(h3['forward'][-63:])))
    # known premium: implied = subsequent realized + 0.05 exactly -> mean premium 0.05, long rho never wins
    fw_known = h3['forward'].copy()
    h3['implied'] = np.where(np.isfinite(fw_known), fw_known + 0.05, h3['trailing'] + 0.05)
    h3['vol_x'] = np.full(nd3, 7.19)
