function monCfg(){                     // fill defaults IN PLACE: handlers hold a reference to S.mon
  const d={tenor:'1M',window:21,ma:5,years:1,maType:'sma',showMaI:true,showMaR:true,zoom:21};
  if(!S.mon)S.mon={};for(const k in d)if(S.mon[k]===undefined)S.mon[k]=d[k];return S.mon;}
function maSeries(x,k,type){
  const n=x.length,out=new Array(n).fill(null);k=Math.max(1,Math.round(k||1));
  if(k===1)return x.map(v=>v==null?null:v);
  if(type==='ema'){                       // seeded with the first value, reported once k values have been seen
    const a=2/(k+1);let e=null,cnt=0;
    for(let i=0;i<n;i++){const v=x[i];if(v==null){out[i]=(e!=null&&cnt>=k)?e:null;continue;}
      e=(e==null)?v:a*v+(1-a)*e;cnt++;out[i]=cnt>=k?e:null;}
    return out;}
  for(let i=k-1;i<n;i++){let s=0,ok=true;for(let j=i-k+1;j<=i;j++){if(x[j]==null){ok=false;break;}s+=x[j];}out[i]=ok?s/k:null;}
  return out;
}
function monMAs(){const D=S.monData,C=monCfg();return {imp:maSeries(D.implied,C.ma,C.maType),real:maSeries(D.realized,C.ma,C.maType)};}
function maLabel(){const C=monCfg();return C.ma+'d '+(C.maType==='ema'?'EMA':'MA');}
