function ovr(kind,t){const o=S.ov[kind][t];return (o!==undefined&&o!==null&&o!==''&&isFinite(o))?+o:null;}
function realized(kind,t){const C=S.corr;if(!C)return null;
  if(kind==='rho'){const c=C.by_tenor[t];return c&&c.rho_quoted!=null?c.rho_quoted:null;}
  if(kind==='rs'){const c=C.vol_vol&&C.vol_vol[t];return c&&c.rho_sig!=null?c.rho_sig:null;}
  return C.corr_vol&&C.corr_vol.value!=null?C.corr_vol.value:null;}
function orient(p){return p.slice(3)==='USD'?1:-1;}
function impliedQ(t){const M=S.mkt;if(!M||!M.rows||!M.rows[t]||!S.legs.A||!S.legs.B)return null;
  const ra=S.legs.A.rows[t],rb=S.legs.B.rows[t];if(!ra||!rb)return null;
  const a=+ra.atm,b=+rb.atm,x=+M.rows[t].atm;if(!(a>0&&b>0&&x>0))return null;
  return orient(S.legs.A.pair)*orient(S.legs.B.pair)*(a*a+b*b-x*x)/(2*a*b);}
function used(kind,t){const o=ovr(kind,t);if(o!==null)return o;
  if(kind==='rho'&&S.rho_src==='implied'){const i=impliedQ(t);if(i!==null&&Math.abs(i)<1)return i;}
  return realized(kind,t);}
