    d_rho = pos(sa_, sb_, ry + 0.01) - pos(sa_, sb_, ry)
    check('trade is leg-vol neutral and earns the stated P&L per +0.01 rho',
          d_leg < 1.0 and abs(d_rho - tc['pnl_per_rho_point']) / tc['pnl_per_rho_point'] < 0.01,
          f"(leg 1bp vol bump {d_leg:.2f} USD on 100k vega; +0.01 rho {d_rho:,.0f} vs {tc['pnl_per_rho_point']:,.0f})")
    H = get_corr_history('EURUSD', 'USDCAD', '3M', 3)
    stH = H['stats']
