REFRESH = {'mins': 180, 'window': (6 * 60, 20 * 60), 'weekdays_only': True, 'next': None, 'next_dt': None, 'progress': '',
           'running': False, 'last': None, 'last_secs': None, 'last_error': '', 'last_counts': '',
           'lock': threading.Lock()}


def next_refresh_after(now, mins, window=None, weekdays_only=False):
    """Next slot on a `mins` grid from midnight (60 -> on the hour) inside the window (minutes from
    midnight, inclusive) and, if asked, on a weekday."""
    if not mins or mins <= 0:
        return None
    t = now.replace(second=0, microsecond=0)
    cand = t.replace(hour=0, minute=0) + timedelta(minutes=((t.hour * 60 + t.minute) // mins + 1) * mins)
    for _ in range(8 * 24 * 60 // mins + 2):
        mm = cand.hour * 60 + cand.minute
        if (window is None or window[0] <= mm <= window[1]) and (not weekdays_only or cand.weekday() < 5):
            return cand
        cand += timedelta(minutes=mins)
    return None


def _fmt_next(dt):
    if dt is None:
        return None
    return dt.strftime('%H:%M') if dt.date() == date.today() else dt.strftime('%a %H:%M')


def prefetch_combo(a, b):
    """Everything the main tab needs for a pair of legs (default settings) into the store.
    Run in prefer_store mode: only pieces the store doesn't have are pulled. True if all went through."""
    jobs = [(get_surface, (a,))] if b is None else [
        (get_surface, (a,)), (get_surface, (b,)), (get_cross_market, (a, b)), (get_corr, (a, b)),
        (get_corr_ci, (a, b)), (get_corr_monitor, (a, b)), (get_corr_history, (a, b, '3M', 3))]
    ok = True
    for fn, args in jobs:
        try:
            fn(*args)
        except Exception as e:
            ok = False
            log(f'prefetch {fn.__name__}{args} failed: {e}')
    return ok


def refresh_shared(reason='scheduled'):
    """Re-pull everything the site has used (+ anything queued), rebuild the CAD board(s)."""
    with REFRESH['lock']:
        if REFRESH['running']:
            return False
        REFRESH['running'] = True
    t0, err, counts = time.time(), '', ''
    try:
        if not BB.available():
            raise RuntimeError('Bloomberg offline (' + (BB.last_error or 'no session') + ')')
        refs, hists, combos, cad = STORE.snapshot_keys()
        today = date.today()
        with data_mode_ctx('live'):
            groups = {}
            for tk, fs in refs.items():
                groups.setdefault(frozenset(fs), []).append(tk)
            for fs, tks in groups.items():
                for i in range(0, len(tks), 400):
                    BB.ref(tks[i:i + 400], sorted(fs))
            hg = {}
            for (tk, f), (st, en) in hists.items():
                s0 = st if en is None else max(st, en - timedelta(days=10))        # top up the last 10 days
                hg.setdefault((f, s0), []).append(tk)
            for (f, s0), tks in hg.items():
                for i in range(0, len(tks), 50):
                    BB.hist(tks[i:i + 50], f, s0, today)
        # the universe + every pair in use gets its complete bundle (surface, band, monitor, analytics at the
        # default settings). Bundles loaded before were just topped up above and are skipped here.
        targets = combos | universe_combos()
        with STORE.lock:
            todo = sorted(targets - STORE.complete, key=lambda c: (c[1] is not None, str(c)))
        n_new = 0
        with data_mode_ctx('prefer_store'):
            for i, (a, b) in enumerate(todo):
                REFRESH['progress'] = f'{i + 1}/{len(todo)}'
                if prefetch_combo(a, b):
                    n_new += 1
                    with STORE.lock:
                        STORE.complete.add((a, b))
        REFRESH['progress'] = ''
        with STORE.lock:
            STORE.wanted_combos -= combos
        _CI_CACHE.clear()
        CAD_BOARD._corr_cache.clear()
        srcs = CAD_BOARD.built_sources() | ({'implied'} if cad else set())
        if srcs:
            CAD_BOARD.start(sorted(srcs), mode='live', wait=True)
            with STORE.lock:
                STORE.wanted_cad = False
        counts = (f'{len(refs)} quote tickers, {len(hists)} histories topped up' + (f', {n_new} new pair bundles loaded' if n_new else '')
                  + f', {len(targets)} pairs/legs kept loaded'
                  + (f', CAD board ({"/".join(sorted(srcs))})' if srcs else ''))
        log(f'shared refresh ({reason}): {counts} in {time.time() - t0:.1f}s')
    except Exception as e:
        err = f'{type(e).__name__}: {e}'
        log(f'shared refresh ({reason}) failed: {err}')
    finally:
        with REFRESH['lock']:
            REFRESH.update(running=False, last=datetime.now().strftime('%H:%M:%S'), last_secs=round(time.time() - t0, 1),
                           last_error=err, last_counts=counts)
    return True


def refresh_info():
    out = {k: REFRESH[k] for k in ('mins', 'next', 'running', 'last', 'last_secs', 'last_error', 'last_counts', 'progress')}
    out['universe'] = UNIVERSE['mode'] if UNIVERSE['mode'] in ('used', 'all') else f"{len(universe_combos()) - len(LEG_PAIRS)} crosses + {len(LEG_PAIRS)} legs"
    w = REFRESH['window']
    out['window'] = None if w is None else '%02d:%02d-%02d:%02d' % (w[0] // 60, w[0] % 60, w[1] // 60, w[1] % 60)
    out['weekdays_only'] = REFRESH['weekdays_only']
    return out


def refresh_scheduler():
    while True:
        nxt = next_refresh_after(datetime.now(), REFRESH['mins'], REFRESH['window'], REFRESH['weekdays_only'])
        REFRESH['next_dt'], REFRESH['next'] = nxt, _fmt_next(nxt)
        if nxt is None:
            return
        while datetime.now() < nxt:
            time.sleep(min(20.0, max(0.5, (nxt - datetime.now()).total_seconds())))
        refresh_shared('scheduled')


